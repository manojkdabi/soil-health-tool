// ── E3: Auto-Run Pipeline (async chain) ──────────────────────────────────────
// Steps: Fetch Crop TS → lock CPI → Fetch Soil TS → lock SHPI → Run Analysis
// Year selection is researcher-controlled via chip rows — no Tukey auto-filter.
async function autoRunPipeline_() {
  if (!roi) { alert('Draw or upload an ROI first.'); return }
  var btn = document.getElementById('autoRunBtn')
  if (btn) { btn.disabled = true; btn.textContent = 'Running...' }
  autoLogClear_()
  var season = activePipelineSeason || 'kharif'
  var yearStart = parseInt(document.getElementById('yearStart').value, 10)
  var yearEnd   = parseInt(document.getElementById('yearEnd').value, 10)
  if (isNaN(yearStart) || isNaN(yearEnd)) {
    autoLogLine_('[ERROR] Set a valid year range first.', true)
    if (btn) { btn.disabled = false; btn.textContent = '🚀 Auto-Run Pipeline' }
    return
  }
  // Log custom windows if active
  if (customCropMonthStart !== null) {
    autoLogLine_('[G] Custom windows: bare ' + MON_ABBR[customBareMonthStart - 1] + '–' + MON_ABBR[customBareMonthEnd - 1] +
      ', crop ' + MON_ABBR[customCropMonthStart - 1] + '–' + MON_ABBR[customCropMonthEnd - 1] + ', season: ' + season)
  }
  try {
    // [1/7] Fetch crop time series
    autoLogLine_('[1/7] Fetching crop time series...')
    await new Promise(function(resolve, reject) {
      google.script.run
        .withSuccessHandler(async function(data) {
          if (!data.success) { reject(new Error(data.error)); return }
          var decoded = await Promise.all(data.windows.map(async function(w) {
            var v = await decodeTsWindowPng_(w.img64)
            return v ? Object.assign({ date: w.date }, v) : null
          }))
          tsData = decoded.filter(Boolean)
          if (tsData.length === 0) { reject(new Error('No valid crop observations.')); return }
          var years = Array.from(new Set(tsData.map(function(d) { return d.date.substring(0, 4) }))).sort()
          buildYearCheckboxes_(years)
          document.getElementById('tsIndexBtns').style.display = 'block'
          document.getElementById('tsViewBtns').style.display = 'block'
          document.getElementById('tsChartWrap').style.display = 'block'
          renderTsChart_(tsCurIndex)
          resolve()
        })
        .withFailureHandler(reject)
        .getTimeSeries({ geojson: roi, yearStart: yearStart, yearEnd: yearEnd })
    })
    var allCropYrs = Array.from(new Set(tsData.map(function(d) { return d.date.substring(0, 4) }))).sort()
    autoLogLine_('[1/7] Crop TS fetched (' + allCropYrs[0] + '-' + allCropYrs[allCropYrs.length - 1] + ')')

    // [2/7] CPI years — researcher chip row (no auto-filter, B1/P2)
    buildFetchCpiChips_(allCropYrs)
    autoLogLine_('[2/7] CPI years: ' + allCropYrs.join(', ') + ' — toggle chips to include/exclude')

    // [3/7] Lock CPI years (uses current tsSelectedYears from chips)
    useYearsForCpi_()
    autoLogLine_('[3/7] CPI locked: ' + tsYearsForCpi.join(', '))

    // [4/7] Fetch soil time series
    autoLogLine_('[4/7] Fetching soil time series...')
    await new Promise(function(resolve, reject) {
      google.script.run
        .withSuccessHandler(async function(data) {
          if (!data.success) { reject(new Error(data.error)); return }
          var decoded = await Promise.all(data.windows.map(async function(w) {
            var v = await decodeSoilTsWindowPng_(w.img64)
            return v ? Object.assign({ date: w.date }, v) : null
          }))
          soilTsData = decoded.filter(Boolean)
          if (soilTsData.length === 0) { reject(new Error('No valid bare-soil observations.')); return }
          document.getElementById('soilIndexBtns').style.display = 'block'
          document.getElementById('soilViewBtns').style.display = 'block'
          document.getElementById('soilChartWrap').style.display = 'block'
          renderSoilTsChart_(soilCurIndex)
          var soilYrs = Array.from(new Set(soilTsData.map(function(d) { return d.date.substring(0, 4) }))).sort()
          buildSoilYearCheckboxes_(soilYrs)
          resolve()
        })
        .withFailureHandler(reject)
        .getSoilTimeSeries({ geojson: roi, yearStart: yearStart, yearEnd: yearEnd })
    })
    var allSoilYrs = Array.from(new Set(soilTsData.map(function(d) { return d.date.substring(0, 4) }))).sort()
    autoLogLine_('[4/7] Soil TS fetched (' + allSoilYrs[0] + '-' + allSoilYrs[allSoilYrs.length - 1] + ')')

    // [5/7] SHPI years — researcher chip row (no auto-filter, B1/P2)
    buildFetchShpiChips_(allSoilYrs)
    autoLogLine_('[5/7] SHPI years: ' + allSoilYrs.join(', ') + ' — toggle chips to include/exclude')

    // [6/7] Lock SHPI years (uses current soilSelectedYears from chips)
    useYearsForShpi_()
    autoLogLine_('[6/7] SHPI locked: ' + tsYearsForShpi.join(', '))

    // [7/7] Run Phase 1 Analysis
    autoLogLine_('[7/7] Running Phase 1 Analysis...')
    // runAnalysis is synchronous from the UI perspective; Stage I runs after it completes
    // by watching for lastResult to be populated. We wrap it in a short poll.
    runAnalysis()
    // [8/8] Stage I — per-year spatial filter (runs after Phase 1 analysis decodes)
    autoLogLine_('[8/8] Stage I: will start after Phase 1 raster decodes...')
    await new Promise(function(resolve) {
      var attempts = 0
      var maxAttempts = 60  // wait up to 30 seconds (500 ms × 60)
      var poll = setInterval(function() {
        attempts++
        if (lastResult || attempts >= maxAttempts) {
          clearInterval(poll)
          resolve()
        }
      }, 500)
    })
    if (lastResult) {
      autoLogLine_('[8/8] Stage I: fetching per-year rasters (' + tsYearsForShpi.join(',') + ')...')
      try {
        await runStageI_(season, tsYearsForShpi)
      } catch(siErr) {
        autoLogLine_('[8/8] Stage I failed: ' + siErr.message, true)
      }
    }

    // [9/8] Stage K — biweekly NDVI-AUC per pixel
    if (lastResult && stageIResult && stageIResult.tukey.retained.length > 0) {
      autoLogLine_('[9/8] Stage K: fetching biweekly NDVI for AUC (' + stageIResult.tukey.retained.join(',') + ')...')
      try {
        await runStageK_(season, stageIResult.tukey.retained)
      } catch(kErr) {
        autoLogLine_('[9/8] Stage K failed: ' + kErr.message, true)
      }
    }

  } catch (err) {
    autoLogLine_('[ERROR] ' + err.message, true)
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = '🚀 Auto-Run Pipeline' }
    setBadge_('fetchBadge', '✓ done')
    setBadge_('fieldTsBadge', '✓')
    // Reset custom windows so next plain Auto-Run uses season defaults
    customCropMonthStart = null; customCropMonthEnd = null
    customBareMonthStart = null; customBareMonthEnd = null
  }
}
