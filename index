function renderCpiPassesChart_(year) {
  var season = stageMSeason || activePipelineSeason || 'kharif'
  var passes = (cropPassPixels[season] || {})[year]
  var statusEl = document.getElementById('cpiPassesStatus')
  if (!passes || passes.length === 0) {
    if (statusEl) statusEl.textContent = 'ⓘ No data for ' + year + '. Load pass rasters in ③e.'
    return
  }
  if (statusEl) statusEl.textContent = ''

  // Extract field-mean CPI per pass (filter valid pixels)
  var labels = [], fieldMeans = []
  passes.forEach(function(p) {
    labels.push(p.label || p.date.substring(5))
    var pix = p.pixels
    if (!pix) { fieldMeans.push(null); return }
    var sum = 0, cnt = 0
    for (var i = 0; i < pix.length; i++) { if (pix[i] >= 0) { sum += pix[i]; cnt++ } }
    fieldMeans.push(cnt > 0 ? sum / cnt : null)
  })

  // Build per-pixel datasets (up to 100 pixels sampled for chart readability)
  // For the trajectory, x = pass index, y = CPI value for that pixel
  var refPass = passes.find(function(p) { return p.pixels })
  var pixelCount = refPass ? refPass.pixels.length : 0
  // Sample up to 100 pixels for chart readability
  var sampleStep = Math.max(1, Math.floor(pixelCount / 100))
  var pixelDatasets = []
  // Gap 4 fix: per-pixel peak-date scatter data
  var peakScatterPts = []
  for (var pi = 0; pi < pixelCount; pi += sampleStep) {
    var traj = passes.map(function(p) { return p.pixels && p.pixels[pi] >= 0 ? p.pixels[pi] : null })
    // Only include pixel if it has at least some valid observations
    if (traj.some(function(v) { return v !== null })) {
      pixelDatasets.push({ label: 'px' + pi, data: traj, borderColor: 'rgba(46,204,113,0.18)', borderWidth: 0.8, pointRadius: 0, tension: 0.3, spanGaps: true })
      // Find peak pass index for this pixel
      var peakVal = -Infinity, peakPi = -1
      for (var ti = 0; ti < traj.length; ti++) {
        if (traj[ti] !== null && traj[ti] > peakVal) { peakVal = traj[ti]; peakPi = ti }
      }
      if (peakPi >= 0) peakScatterPts.push({ x: peakPi, y: peakVal })
    }
  }
  // Peak dots dataset (one dot per sampled pixel at its peak pass)
  var peakDotsDataset = {
    label: 'Peak', type: 'scatter',
    data: peakScatterPts,
    backgroundColor: 'rgba(245,166,35,0.7)', pointRadius: 3, pointHoverRadius: 4,
    order: 1
  }

  var canvas = document.getElementById('cpiPassesChart')
  if (!canvas) return
  if (cpiPassesChartInst) { cpiPassesChartInst.destroy(); cpiPassesChartInst = null }
  cpiPassesChartInst = new Chart(canvas, {
    type: 'line',
    data: {
      labels: labels,
      datasets: pixelDatasets.concat([peakDotsDataset, {
        label: 'Field mean', data: fieldMeans, borderColor: '#F5A623', backgroundColor: 'transparent',
        borderWidth: 2, pointRadius: 3, pointBackgroundColor: '#F5A623', tension: 0.3, spanGaps: true, order: 0
      }])
    },
    options: {
      responsive: true, maintainAspectRatio: false, animation: false,
      plugins: {
        legend: { display: false },
        tooltip: { mode: 'index', intersect: false,
          filter: function(item) { return item.dataset.label === 'Field mean' },
          callbacks: { label: function(ctx) { return 'Mean CPI: ' + (ctx.parsed.y !== null ? ctx.parsed.y.toFixed(3) : 'n/a') } }
        }
      },
      scales: {
        x: { ticks: { color: '#9FE1CB', font: { size: 8 }, maxRotation: 45 }, grid: { color: '#1e3d30' } },
        y: { min: 0, max: 1, title: { display: true, text: 'CPI', color: '#9FE1CB', font: { size: 9 } }, ticks: { color: '#9FE1CB', font: { size: 8 } }, grid: { color: '#1e3d30' } }
      }
    }
  })
}

