    if (!pix) { fieldMeans.push(null); return }
    var sum = 0, cnt = 0
    for (var i = 0; i < pix.length; i++) { if (pix[i] >= 0) { sum += pix[i]; cnt++ } }
    fieldMeans.push(cnt > 0 ? sum / cnt : null)
  })

  var refPass = passes.find(function(p) { return p.pixels })
  var pixelCount = refPass ? refPass.pixels.length : 0
  var sampleStep = Math.max(1, Math.floor(pixelCount / 100))
  var pixelDatasets = []
  var refIdx = refData ? refData.idx : -1
  for (var pi = 0; pi < pixelCount; pi += sampleStep) {
    var traj = passes.map(function(p) { return p.pixels && p.pixels[pi] >= 0 ? p.pixels[pi] : null })
    if (traj.some(function(v) { return v !== null })) {
      pixelDatasets.push({ label: 'px' + pi, data: traj, borderColor: 'rgba(160,130,80,0.18)', borderWidth: 0.8, pointRadius: 0, tension: 0.3, spanGaps: true })
    }
  }

  // Ref-pass gold vertical annotation via pointRadius overrides on field mean
  var refPointColors = labels.map(function(_, i) { return i === refIdx ? '#F5A623' : 'rgba(0,0,0,0)' })
  var refPointSizes  = labels.map(function(_, i) { return i === refIdx ? 6 : 0 })

  var canvas = document.getElementById('shpiPassesChart')
  if (!canvas) return
  if (shpiPassesChartInst) { shpiPassesChartInst.destroy(); shpiPassesChartInst = null }
  shpiPassesChartInst = new Chart(canvas, {
    type: 'line',
    data: {
      labels: labels,
      datasets: pixelDatasets.concat([{
        label: 'Field mean', data: fieldMeans, borderColor: '#c8a060', backgroundColor: 'transparent',
        borderWidth: 2, pointRadius: refPointSizes, pointBackgroundColor: refPointColors, tension: 0.3, spanGaps: true, order: 0
      }])
    },
    options: {
      responsive: true, maintainAspectRatio: false, animation: false,
      plugins: {
        legend: { display: false },
        tooltip: { mode: 'index', intersect: false,
          filter: function(item) { return item.dataset.label === 'Field mean' },
          callbacks: {
            label: function(ctx) {
              var refStr = ctx.dataIndex === refIdx ? ' ★ Ref pass' : ''
              return 'Mean SHPI: ' + (ctx.parsed.y !== null ? ctx.parsed.y.toFixed(3) : 'n/a') + refStr
            }
          }
        }
      },
      scales: {
        x: { ticks: { color: '#9FE1CB', font: { size: 8 }, maxRotation: 45 }, grid: { color: '#1e3d30' } },
        y: { min: 0, max: 1, title: { display: true, text: 'SHPI', color: '#9FE1CB', font: { size: 9 } }, ticks: { color: '#9FE1CB', font: { size: 8 } }, grid: { color: '#1e3d30' } }
      }
    }
  })
}

// ── M8: Season change handler in ③e ───────────────────────────
function onStageMSeasonChange_() {
  var sel = document.getElementById('stageMSeasonSel')
  if (sel) {
    stageMSeason = sel.value
    // Re-populate year selector if data already loaded for the new season
    var years = Object.keys((cropPassPixels[stageMSeason] || {})).map(Number).sort()
    if (years.length > 0) {
      populateStageMYearSel_(stageMSeason, years)
      renderPassDateGrid_()
    }
  }
}

// Reveal ③e step after Stage M data is loaded (called externally after auto-run if desired)
function revealPassExplorerStep_() {
  var el = document.getElementById('passExplorerStep')
  if (el) el.style.display = 'block'
}

// ── N3: Per-pass OLS hypothesis verdict ──────────────────────
// Pools (refSHPI, CPI) pairs from all accepted years for each pass index,
// finds the pass with the highest pooled OLS R², and returns the OLS verdict.
function computeBestPassHypothesis_(season) {
  var yearMap = stageMOlsMap[season]
  if (!yearMap) return null
  var acceptedYears = (stageIResult && stageIResult.tukey && stageIResult.tukey.retained.length > 0)
    ? stageIResult.tukey.retained.map(Number).sort()
    : Object.keys(yearMap).map(Number).sort()
  if (acceptedYears.length === 0) return null

  // Determine max pass slots (use the year with most passes)
  var maxPasses = 0
  acceptedYears.forEach(function(yr) {
    var passes = (cropPassPixels[season] || {})[yr] || []
    if (passes.length > maxPasses) maxPasses = passes.length
  })
  if (maxPasses === 0) return null

  // For each pass index, pool pixel pairs across all accepted years; find highest R²
  var bestR2 = -Infinity, bestPassIdx = 0, bestPassLabel = '', bestPassDate = '', bestAllPts = []
  for (var pi = 0; pi < maxPasses; pi++) {
    var allPts = []
    acceptedYears.forEach(function(yr) {
      var refData    = (refShpiPassMap[season] || {})[yr]
      var cropPasses = (cropPassPixels[season] || {})[yr] || []
      if (!refData || !cropPasses[pi] || !cropPasses[pi].pixels) return
      var refPix = refData.pixels, cpiPix = cropPasses[pi].pixels
      var len = Math.min(refPix.length, cpiPix.length)
      for (var i = 0; i < len; i++) {
        if (refPix[i] >= 0 && cpiPix[i] >= 0) allPts.push({ x: refPix[i], y: cpiPix[i] })
      }
    })
    if (allPts.length < 3) continue
    var ols = computeOlsFull_(allPts.map(function(p) { return p.x }), allPts.map(function(p) { return p.y }))
    if (ols && ols.r2 > bestR2) {
      bestR2 = ols.r2
      bestPassIdx = pi
      // Get label/date from first available year
      for (var yi = 0; yi < acceptedYears.length; yi++) {
        var cp = (cropPassPixels[season] || {})[acceptedYears[yi]] || []
        if (cp[pi]) { bestPassLabel = cp[pi].label || cp[pi].date || ''; bestPassDate = cp[pi].date || ''; break }
      }
      bestAllPts = allPts
    }
  }

  if (bestAllPts.length === 0) return null
  var bestOls = computeOlsFull_(bestAllPts.map(function(p) { return p.x }), bestAllPts.map(function(p) { return p.y }))
  if (!bestOls) return null
  // Verdict: positive slope AND R² ≥ 0.10 (soil explains ≥10% of CPI spatial variance)
  var confirmed = bestOls.slope > 0 && bestOls.r2 >= 0.10
  var marginal  = !confirmed && bestOls.slope > 0 && bestOls.r2 >= 0.05
  return {
    confirmed: confirmed,
    marginal:  marginal,
    r2: bestOls.r2, slope: bestOls.slope, intercept: bestOls.intercept,
    passIdx: bestPassIdx, passLabel: bestPassLabel, passDate: bestPassDate,
    n: bestAllPts.length, ols: bestOls
  }
}

// Update ④ CONCLUDE banner and hypothesis stat card using Stage M best-R² pass verdict
function updateConcludeFromBestPass_(season) {
  var result = computeBestPassHypothesis_(season)
  var banner = document.getElementById('banner')
  if (!banner) return

  if (!result || result.n < 3) {
    banner.textContent = '⚠ Insufficient pass data — try a different season or year set'
    banner.className   = 'banner banner-no'
    setBadge_('concludeBadge', '⚠')
    var sv = document.getElementById('hypothesisStatVal')
    if (sv) sv.textContent = 'NO'
    return
  }

  var r2Str    = result.r2.toFixed(3)
  var slopeStr = result.slope.toFixed(4)
  if (result.confirmed) {
    banner.textContent = '✓ Hypothesis confirmed — best pass ' + result.passLabel + ', β₁=' + slopeStr + ', R²=' + r2Str + ' (n=' + result.n + ')'
    banner.className   = 'banner banner-yes'
    setBadge_('concludeBadge', 'R²=' + r2Str + ' ✓')
    var sv = document.getElementById('hypothesisStatVal')
    if (sv) sv.textContent = 'YES'
  } else if (result.marginal) {
    banner.textContent = '⚠ Hypothesis marginal — best pass ' + result.passLabel + ', β₁=' + slopeStr + ', R²=' + r2Str + ' (n=' + result.n + ')'
    banner.className   = 'banner banner-no'
    setBadge_('concludeBadge', 'R²=' + r2Str + ' ~')
    var sv = document.getElementById('hypothesisStatVal')
    if (sv) sv.textContent = 'MARG'
  } else {
    banner.textContent = '⚠ Hypothesis not confirmed — best pass ' + result.passLabel + ', β₁=' + slopeStr + ', R²=' + r2Str + ' (n=' + result.n + ')'
    banner.className   = 'banner banner-no'
    setBadge_('concludeBadge', 'R²=' + r2Str + ' ✗')
    var sv = document.getElementById('hypothesisStatVal')
    if (sv) sv.textContent = 'NO'
  }
}
