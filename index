<!-- ── Stage I: Per-year spatial filter ──────────────────────────────────── -->
<script>

// ── I-helper: OLS linear regression on arrays ────────────────────────────────
// Returns { slope, intercept, r2 } or null for n < 2.
function olsArr_(xs, ys) {
  var n = xs.length
  if (n < 2) return null
  var xm = 0, ym = 0
  for (var i = 0; i < n; i++) { xm += xs[i]; ym += ys[i] }
  xm /= n; ym /= n
  var ssx = 0, sxy = 0
  for (var i = 0; i < n; i++) { var dx = xs[i] - xm; ssx += dx * dx; sxy += dx * (ys[i] - ym) }
  if (ssx === 0) return null
  var slope = sxy / ssx
  var intercept = ym - slope * xm
  var ssRes = 0, ssTot = 0
  for (var j = 0; j < n; j++) {
    var r = ys[j] - (slope * xs[j] + intercept); ssRes += r * r
    var t = ys[j] - ym; ssTot += t * t
  }
  var r2 = ssTot > 0 ? 1 - ssRes / ssTot : 0
  return { slope: Math.round(slope * 10000) / 10000, intercept: Math.round(intercept * 10000) / 10000, r2: Math.round(r2 * 10000) / 10000 }
}

// ── I-helper: Decode a per-year PNG pair from Stage I API response ────────────
// Returns a promise resolving to { shpi: Float32Array, cpi: Float32Array } or null.
function decodePerYearPngs_(shpiB64, cpiB64) {
  return new Promise(function(resolve) {
    if (!shpiB64 || !cpiB64) { resolve(null); return }
    var shpiImg = new Image(), cpiImg = new Image()
    var shpiDone = false, cpiDone = false
    var shpiArr = null, cpiArr = null, W = 0, H = 0

    function tryResolve() {
      if (!shpiDone || !cpiDone) return
      if (!shpiArr || !cpiArr || shpiArr.length !== cpiArr.length) { resolve(null); return }
      resolve({ shpi: shpiArr, cpi: cpiArr, W: W, H: H })
    }

    shpiImg.onload = function() {
      W = shpiImg.naturalWidth; H = shpiImg.naturalHeight
      var c = document.createElement('canvas'); c.width = W; c.height = H
      var ctx = c.getContext('2d'); ctx.drawImage(shpiImg, 0, 0)
      var px = ctx.getImageData(0, 0, W, H).data
      var total = W * H
      shpiArr = new Float32Array(total)
      for (var i = 0; i < total; i++) {
        shpiArr[i] = px[i * 4 + 3] > 0 ? px[i * 4] / 254 : -1  // R=SHPI×254, A=count
      }
      shpiDone = true; tryResolve()
    }
    shpiImg.onerror = function() { shpiDone = true; tryResolve() }

    cpiImg.onload = function() {
      var cW = cpiImg.naturalWidth, cH = cpiImg.naturalHeight
      var c = document.createElement('canvas'); c.width = cW; c.height = cH
      var ctx = c.getContext('2d'); ctx.drawImage(cpiImg, 0, 0)
      var px = ctx.getImageData(0, 0, cW, cH).data
      var total = cW * cH
      cpiArr = new Float32Array(total)
      for (var i = 0; i < total; i++) {
        cpiArr[i] = px[i * 4 + 3] > 0 ? px[i * 4 + 1] / 254 : -1  // G=CPI×254, A=count
      }
      cpiDone = true; tryResolve()
    }
    cpiImg.onerror = function() { cpiDone = true; tryResolve() }

    shpiImg.src = 'data:image/png;base64,' + shpiB64
    cpiImg.src  = 'data:image/png;base64,' + cpiB64
  })
}

// ── I1: Build per-year pixel pairs with ROI polygon mask ─────────────────────
// yearData: { year, shpi: Float32Array, cpi: Float32Array, W, H }
// geojson: ROI polygon; bbox: [minLng, minLat, maxLng, maxLat]
// Returns [{shpi, cpi}, ...] — pixels with valid (non-negative) values inside ROI
function buildPerYearPixelPairs_(yearData, geojson, bbox) {
  var shpiArr = yearData.shpi, cpiArr = yearData.cpi
  var W = yearData.W, H = yearData.H
  var pairs = []
  if (!shpiArr || !cpiArr || shpiArr.length !== cpiArr.length) return pairs
  var polyMask = null
  if (bbox && geojson) {
    var lngRange = bbox[2] - bbox[0], latRange = bbox[3] - bbox[1]
    if (lngRange > 0 && latRange > 0) {
      polyMask = new Uint8Array(W * H)
      for (var mi = 0; mi < W * H; mi++) {
        var col = mi % W, row = Math.floor(mi / W)
        var lng = bbox[0] + (col + 0.5) / W * lngRange
        var lat = bbox[3] - (row + 0.5) / H * latRange
        polyMask[mi] = pointInPolygon_(lng, lat, geojson) ? 1 : 0
      }
    }
  }
  for (var i = 0; i < shpiArr.length; i++) {
    if (polyMask && !polyMask[i]) continue
    if (shpiArr[i] < 0 || cpiArr[i] < 0) continue
    pairs.push({ shpi: shpiArr[i], cpi: cpiArr[i] })
  }
  return pairs
}

// ── I2: Compute per-year OLS R² from pixel pairs ─────────────────────────────
// perYearPairs: { year: [{shpi, cpi}, ...] }
// Returns { year: r2 (number|null), ... }
function computePerYearR2_(perYearPairs) {
  var r2Map = {}
  Object.keys(perYearPairs).forEach(function(yr) {
    var pairs = perYearPairs[yr]
    if (pairs.length < 3) { r2Map[yr] = null; return }
    var xs = pairs.map(function(p) { return p.shpi })
    var ys = pairs.map(function(p) { return p.cpi })
    var res = olsArr_(xs, ys)
    r2Map[yr] = res ? res.r2 : null
  })
  return r2Map
}

// ── I3: All fetched years are retained — researcher controls inclusion via chips ─
// r2Map: { year: r2 (number|null) }
// Returns { retained: [year, ...], rejected: [] }
function stageIRetainAll_(r2Map) {
  var allYears = Object.keys(r2Map).filter(function(yr) { return r2Map[yr] !== null })
  return { retained: allYears, rejected: [] }
}

// ── I5: Run adaptive binning + OLS hypothesis on pooled per-year pairs ────────
// pooledPairs: [{shpi, cpi}, ...] from all retained years
// Returns validation object (same shape as decodeRasterToResult_ validation block)
function stageIAdaptiveBins_(pooledPairs) {
  if (pooledPairs.length < 6) {
    return { confirmed: null, n_zones: 0, r_squared: 0,
             cpi_ratio: null, shpi_thresholds: [], data_source: 'stage_i' }
  }
  // F1: nBins = floor(n/3) — 3 pairs per bin is the minimum for a meaningful bin mean; capped [2,10]
  var nBins = Math.min(10, Math.max(2, Math.floor(pooledPairs.length / 3)))
  var shpiSorted = pooledPairs.map(function(p) { return p.shpi }).sort(function(a, b) { return a - b })
  var cuts = []
  for (var ki = 1; ki < nBins; ki++) cuts.push(percentile_(shpiSorted, ki / nBins * 100))
  function assignBin(v) {
    for (var ci = 0; ci < cuts.length; ci++) { if (v < cuts[ci]) return ci }
    return nBins - 1
  }
  var bins = []
  for (var bi = 0; bi < nBins; bi++) bins.push([])
  pooledPairs.forEach(function(p) { bins[assignBin(p.shpi)].push(p) })
  function mean(arr, k) { return arr.length ? arr.reduce(function(s, p) { return s + p[k] }, 0) / arr.length : 0 }
  var binMeansShpi = bins.map(function(b) { return mean(b, 'shpi') })
  var binMeansCpi  = bins.map(function(b) { return mean(b, 'cpi') })
  // OLS on bin means for exploratory chart (③d ZONE MEANS)
  var binOls = olsArr_(binMeansShpi, binMeansCpi)
  var binR2    = binOls ? binOls.r2 : 0
  var binSlope = binOls ? binOls.slope : 0
  // CPI ratio: lowest to highest bin; guard against near-zero denominator (< 0.01 = bare soil / no crop)
  var ratio = (nBins >= 2 && binMeansCpi[0] > 0.01)
    ? Math.round(binMeansCpi[nBins - 1] / binMeansCpi[0] * 100) / 100 : null
  // Confirmation: positive slope AND R² ≥ 0.10 on bin means (exploratory only; hypothesis driven by Stage M OLS)
  var confirmed = nBins === 0 ? null : (binSlope > 0 && binR2 >= 0.10)
  return {
    confirmed: confirmed, n_zones: nBins, r_squared: binR2,
    cpi_ratio: ratio, shpi_thresholds: cuts, data_source: 'stage_i',
    bin_means_shpi: binMeansShpi, bin_means_cpi: binMeansCpi
  }
}

// ── Main Stage I orchestrator ─────────────────────────────────────────────────
// season: 'kharif'|'rabi'; years: string[] (locked SHPI years)
// Fetches per-year rasters, builds pairs, computes OLS R²_y per year,
// pools all retained years (researcher controls via chips), runs adaptive binning.
async function runStageI_(season, years) {
  if (!roi || !lastResult) return
  var bbox = lastResult.bbox
  if (!bbox) return
  var yearInts = years.map(function(y) { return parseInt(y, 10) }).filter(Boolean)
  if (yearInts.length === 0) return

  // Clear stale result so Stage K does not run with outdated Stage I results if this run fails
  stageIResult = null
  var apiResult = await new Promise(function(resolve, reject) {
    google.script.run
      .withSuccessHandler(resolve)
      .withFailureHandler(reject)
      .getPerYearRasters({ geojson: roi, season: season, years: yearInts })
  })
  if (!apiResult || !apiResult.success) throw new Error(apiResult ? apiResult.error : 'GAS call failed')

  // Decode all per-year PNG pairs
  var perYearPairs = {}
  var perYearPairsRaw = {}
  for (var i = 0; i < apiResult.years.length; i++) {
    var yrData = apiResult.years[i]
    var decoded = await decodePerYearPngs_(yrData.shpiB64, yrData.cpiB64)
    if (!decoded) continue
    var pairs = buildPerYearPixelPairs_(decoded, roi, bbox)
    if (pairs.length < 3) continue
    perYearPairs[yrData.year]   = pairs
    perYearPairsRaw[yrData.year] = decoded  // keep full arrays for scatter
  }

  // Cache decoded rasters
  if (!perYearRastersCache[season]) perYearRastersCache[season] = {}
  Object.assign(perYearRastersCache[season], perYearPairsRaw)

  // Diagnostic: detect if any two years share identical SHPI values (stable soil / fetch overlap)
  var shpiIdenticalWarning = ''
  var rawYearKeys = Object.keys(perYearPairsRaw)
  if (rawYearKeys.length >= 2) {
    var nCheck = Math.min(200, (perYearPairsRaw[rawYearKeys[0]].shpi || []).length)
    var identicalPairs = []
    for (var qi = 0; qi < rawYearKeys.length; qi++) {
      for (var qj = qi + 1; qj < rawYearKeys.length; qj++) {
        var arrA = perYearPairsRaw[rawYearKeys[qi]].shpi
        var arrB = perYearPairsRaw[rawYearKeys[qj]].shpi
        var same = (arrA && arrB && arrA.length === arrB.length && nCheck > 0)
        if (same) {
          for (var qq = 0; qq < nCheck; qq++) {
            if (arrA[qq] !== arrB[qq]) { same = false; break }
          }
        }
        if (same) identicalPairs.push(rawYearKeys[qi] + '/' + rawYearKeys[qj])
      }
    }
    if (identicalPairs.length > 0) {
      shpiIdenticalWarning = ' ⚠ SHPI identical for years ' + identicalPairs.join(', ') + ' — stable soil or fetch overlap'
    }
  }

  // I2: per-year OLS R²
  var perYearR2 = computePerYearR2_(perYearPairs)

  // I3: all fetched years retained — researcher controls inclusion via chip row (N2)
  var tukey = stageIRetainAll_(perYearR2)

  // I4: pool all retained years
  var pooledPairs = []
  tukey.retained.forEach(function(yr) {
    if (perYearPairs[yr]) pooledPairs = pooledPairs.concat(perYearPairs[yr])
  })

  // I5: adaptive binning on pooled pairs (OLS R²)
  var validation = stageIAdaptiveBins_(pooledPairs)

  stageIResult = {
    season:             season,
    perYearPairs:       perYearPairs,
    perYearR2:          perYearR2,
    tukey:              tukey,
    pooledPairs:        pooledPairs,
    validation:         validation,
    shpiIdenticalWarn:  shpiIdenticalWarning
  }

  // Render Stage I panel in the sidebar
  renderStageIPanel_(stageIResult)

  // Log summary
  autoLogLine_('[8/8] Stage I: ' + tukey.retained.length + ' years | pooled R²=' + validation.r_squared + ' (' + validation.n_zones + ' bins)',
    false)
}

// ── Render Stage I sidebar panel ──────────────────────────────────────────────
var YEAR_COLORS = ['#4DC9F6','#F67019','#F53794','#537BC4','#ACC236','#166A8F','#00A950','#58595B']

function renderStageIPanel_(result) {
  var panel = document.getElementById('stageIPanel')
  var banner = document.getElementById('stageIBanner')
  if (!panel || !result) return
  panel.style.display = 'block'
  var stepEl = document.getElementById('perYearScatterStep')
  if (stepEl) stepEl.style.display = ''
  setBadge_('perYearBadge', '✓')

  // Banner (always shows exploratory OLS result — hypothesis driven by Stage M OLS)
  var v = result.validation
  var bannerText, bannerColor
  if (v.confirmed === null) {
    bannerText = '⚠ Stage I: Insufficient pairs — see ③c Pooled Scatter'
    bannerColor = '#3e5f4a'
  } else if (v.confirmed) {
    bannerText = '✓ Stage I exploratory — R²=' + v.r_squared + ' (' + v.n_zones + ' bins, pooled ' + result.pooledPairs.length + ' pairs)'
    bannerColor = 'rgba(27,120,55,0.35)'
  } else {
    bannerText = '⚠ Stage I exploratory — R²=' + v.r_squared + ' (' + v.n_zones + ' bins)'
    bannerColor = 'rgba(120,27,27,0.35)'
  }
  banner.textContent = bannerText
  banner.style.background = bannerColor

  // Render mini scatter grid (CPI mode by default; AUC toggle available after Stage K)
  stageKMode = 'cpi'
  var cpiBtn = document.getElementById('stageKMeanCpiBtn')
  var aucBtn = document.getElementById('stageKAucBtn')
  if (cpiBtn) cpiBtn.classList.add('active')
  if (aucBtn) { aucBtn.classList.remove('active'); aucBtn.style.opacity = '0.5' }
  renderStageIPanelGrid_(result, 'cpi')
}

// ── Render Stage I fullscreen panel ──────────────────────────────────────────
var stageIFsCharts = {}  // year → Chart instance for FS mini scatter

function renderStageIFsPanel_() {
  var grid   = document.getElementById('stageIFsYearGrid')
  var banner = document.getElementById('stageIFsBanner')
  var tbl    = document.getElementById('stageIFsRhoTable')
  if (!grid) return
  // Destroy old charts
  Object.keys(stageIFsCharts).forEach(function(k) { if (stageIFsCharts[k]) stageIFsCharts[k].destroy() })
  stageIFsCharts = {}
  grid.innerHTML = ''

  if (!stageIResult) {
    banner.textContent = 'Run Auto-Run Pipeline first — Stage I data not available'
    banner.style.background = '#2e3e30'
    return
  }

  var result = stageIResult
  var v = result.validation
  if (v.confirmed === null) {
    banner.textContent = '⚠ Stage I: Insufficient pairs — see ③c Pooled Scatter'
    banner.style.background = '#3e5f4a'
  } else if (v.confirmed) {
    banner.textContent = '✓ Stage I exploratory — R²=' + v.r_squared + ' (' + v.n_zones + ' bins, ' + result.pooledPairs.length + ' pooled pairs)'
    banner.style.background = 'rgba(27,120,55,0.35)'
  } else {
    banner.textContent = '⚠ Stage I exploratory — R²=' + v.r_squared + ' (' + v.n_zones + ' bins)'
    banner.style.background = 'rgba(120,27,27,0.35)'
  }

  var allYears = Object.keys(result.perYearPairs).sort()
  allYears.forEach(function(yr, yi) {
    var pairs = result.perYearPairs[yr]
    var r2    = result.perYearR2[yr]
    var isRej = false  // all years retained — researcher controls via chips
    var color = YEAR_COLORS[yi % YEAR_COLORS.length]

    var wrap = document.createElement('div')
    wrap.style.cssText = 'border:1px solid #2E6B4F;border-radius:6px;padding:8px;background:rgba(0,0,0,0.3);display:flex;flex-direction:column;height:260px'
    var title = document.createElement('div')
    title.style.cssText = 'font-size:11px;font-weight:700;color:' + color + ';text-align:center;margin-bottom:4px;flex-shrink:0'
    title.textContent = yr + (r2 !== null ? '   R² = ' + r2.toFixed(4) : '   R² = n/a')
    wrap.appendChild(title)

    var canvasWrap = document.createElement('div')
    canvasWrap.style.cssText = 'flex:1;position:relative;min-height:0'
    var canvas = document.createElement('canvas')
    canvasWrap.appendChild(canvas)
    wrap.appendChild(canvasWrap)
    grid.appendChild(wrap)

    if (pairs.length < 3) return
    var step = Math.max(1, Math.floor(pairs.length / 500))
    var ptData = []
    for (var pi = 0; pi < pairs.length; pi += step) ptData.push({ x: pairs[pi].shpi, y: pairs[pi].cpi })
    var reg = olsLine_(ptData)
    stageIFsCharts[yr] = new Chart(canvas.getContext('2d'), {
      data: {
        datasets: [
          { type: 'scatter', label: yr, data: ptData,
            backgroundColor: (function() { var c = hexToRgb_(color); return c ? 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + (isRej ? '0.7' : '0.73') + ')' : color + 'bb' })(), pointRadius: 2.5, pointHoverRadius: 4 },
          { type: 'line', label: 'fit', data: reg ? reg.lineData : [],
            borderColor: '#F5A623', borderWidth: 1.5, pointRadius: 0, fill: false }
        ]
      },
      options: {
        responsive: true, maintainAspectRatio: false, animation: false,
        plugins: { legend: { display: false }, tooltip: { enabled: false } },
        scales: {
          x: { title: { display: true, text: 'SHPI', color: '#9FE1CB', font: { size: 9 } },
               ticks: { color: '#9FE1CB', font: { size: 9 } }, grid: { color: '#1e3d30' } },
          y: { title: { display: true, text: 'CPI', color: '#9FE1CB', font: { size: 9 } },
               ticks: { color: '#9FE1CB', font: { size: 9 } }, grid: { color: '#1e3d30' } }
        }
      }
    })
  })

  // R² table
  var rows = allYears.map(function(yr) {
    var r2 = result.perYearR2[yr]
    return '<span style="margin-right:16px;color:#9FE1CB">' +
      yr + ': R² = ' + (r2 !== null && r2 !== undefined ? r2.toFixed(4) : 'n/a') + '  ✓</span>'
  }).join('')
  var warnHtml = result.shpiIdenticalWarn
    ? '<br><span style="color:#F5A623;font-size:10px">' + result.shpiIdenticalWarn + '</span>' : ''
  tbl.innerHTML = '<strong style="color:#F5A623">Per-year R² summary</strong>  ' + rows +
    '<br><span style="color:#6FA898;font-size:10px">Year inclusion via researcher chips · pooled ' + result.pooledPairs.length + ' pairs from ' + result.tukey.retained.length + ' years</span>' + warnHtml
}

