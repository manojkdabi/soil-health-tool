  }
}

// ── K: Re-render only the mini scatter grid in ③b ─────────────────────────────
// mode: 'cpi' uses stageIResult.perYearPairs (SHPI×CPI)
//       'auc' uses stageKResult.perYearAucPairs (SHPI×AUC)
function renderStageIPanelGrid_(result, mode) {
  var grid = document.getElementById('stageIYearGrid')
  var tbl  = document.getElementById('stageIRhoTable')
  if (!grid || !result) return
  var pairs  = mode === 'auc' && stageKResult ? stageKResult.perYearAucPairs  : result.perYearPairs
  var r2Map  = mode === 'auc' && stageKResult ? stageKResult.perYearR2Auc     : result.perYearR2
  var yKey = mode === 'auc' ? 'auc' : 'cpi'
  var yLabel = mode === 'auc' ? 'NDVI-AUC' : 'Mean CPI'
  grid.innerHTML = ''
  var allYears = Object.keys(pairs).sort()
  allYears.forEach(function(yr, yi) {
    var pts   = pairs[yr]
    var r2    = r2Map ? r2Map[yr] : null
    var color = YEAR_COLORS[yi % YEAR_COLORS.length]
    var wrap  = document.createElement('div')
    wrap.style.cssText = 'border:1px solid #2E6B4F;border-radius:4px;padding:4px;background:rgba(0,0,0,0.25)'
    var label = document.createElement('div')
    label.style.cssText = 'font-size:8px;font-weight:700;color:' + color + ';text-align:center;margin-bottom:2px'
    label.textContent = yr + (r2 !== null && r2 !== undefined ? '  R²=' + (typeof r2 === 'number' ? r2.toFixed(4) : r2) : '  R²=n/a')
    wrap.appendChild(label)
    var canvas = document.createElement('canvas')
    canvas.width = 120; canvas.height = 80
    wrap.appendChild(canvas)
    grid.appendChild(wrap)
    var ctx = canvas.getContext('2d')
    if (!pts || pts.length < 3) { ctx.fillStyle = '#555'; ctx.font = '8px sans-serif'; ctx.fillText('< 3 pairs', 20, 40); return }
    var xs = pts.map(function(p) { return p.shpi })
    var ys = pts.map(function(p) { return p[yKey] })
    var xMin = xs.reduce(function(m, v) { return v < m ? v : m }, Infinity)
    var xMax = xs.reduce(function(m, v) { return v > m ? v : m }, -Infinity)
    var yMin = ys.reduce(function(m, v) { return v < m ? v : m }, Infinity)
    var yMax = ys.reduce(function(m, v) { return v > m ? v : m }, -Infinity)
    var xRange = xMax - xMin || 0.01, yRange = yMax - yMin || 0.01
    var pad = 8, cW = 120, cH = 80
    function px(x) { return pad + (x - xMin) / xRange * (cW - 2 * pad) }
    function py(y) { return cH - pad - (y - yMin) / yRange * (cH - 2 * pad) }
    ctx.fillStyle = '#0b1f17'; ctx.fillRect(0, 0, cW, cH)
    var step = Math.max(1, Math.floor(pts.length / 300))
    ctx.fillStyle = color
    for (var pi = 0; pi < pts.length; pi += step) {
      ctx.beginPath(); ctx.arc(px(pts[pi].shpi), py(pts[pi][yKey]), 1.5, 0, 2 * Math.PI); ctx.fill()
    }
    var reg = olsLine_(pts.map(function(p) { return { x: p.shpi, y: p[yKey] } }))
    if (reg && reg.lineData && reg.lineData.length >= 2) {
      var ld = reg.lineData
      ctx.strokeStyle = '#F5A623'; ctx.lineWidth = 1
      ctx.beginPath(); ctx.moveTo(px(ld[0].x), py(ld[0].y)); ctx.lineTo(px(ld[1].x), py(ld[1].y)); ctx.stroke()
    }
  })
  // R² table
  var rows = allYears.map(function(yr) {
    var r2    = r2Map ? r2Map[yr] : null
    var r2Str = r2 !== null && r2 !== undefined ? (typeof r2 === 'number' ? r2.toFixed(4) : r2) : 'n/a'
    return '<span style="color:#9FE1CB">' + yr + ': R²=' + r2Str + ' ✓</span>'
  }).join('  ')
  var warnHtml = (mode === 'cpi' && stageIResult && stageIResult.shpiIdenticalWarn)
    ? '<br><span style="color:#F5A623;font-size:7px">' + stageIResult.shpiIdenticalWarn + '</span>' : ''
  var extra = mode === 'auc' && stageKResult && stageKResult.validationAuc
    ? '<br><span style="color:#F5A623;font-size:7px">AUC exploratory: R²=' + stageKResult.validationAuc.r_squared + ' (' + stageKResult.validationAuc.n_zones + ' bins)</span>'
    : ''
  tbl.innerHTML = rows + warnHtml + extra
}

// ── Stage K orchestrator ──────────────────────────────────────────────────────
// season: 'kharif'|'rabi'; years: string[] (retained from Stage I Tukey fence)
async function runStageK_(season, years) {
  if (!roi || !lastResult || !stageIResult) return
  var bbox = lastResult.bbox
  if (!bbox) return
  var yearInts = years.map(function(y) { return parseInt(y, 10) }).filter(Boolean)
  if (yearInts.length === 0) return

  // Fetch biweekly NDVI rasters from GAS
  var apiResult = await new Promise(function(resolve, reject) {
    google.script.run
      .withSuccessHandler(resolve)
      .withFailureHandler(reject)
      .getWeeklyCpiRasters({ geojson: roi, season: season, years: yearInts })
  })
  if (!apiResult || !apiResult.success) throw new Error(apiResult ? apiResult.error : 'GAS call failed')

  // Decode all biweekly PNGs per year and compute per-pixel AUC
  if (!stageKCache[season]) stageKCache[season] = {}
  var perYearAucPairs = {}
  var perYearR2Auc    = {}

  for (var i = 0; i < apiResult.years.length; i++) {
    var yrEntry = apiResult.years[i]
    var yr = yrEntry.year

    // Decode all weekly PNGs for this year
    var weeklyDecoded = []
    for (var wi = 0; wi < yrEntry.weeks.length; wi++) {
      var decoded = await decodeWeeklyNdvi_(yrEntry.weeks[wi].ndviB64)
      if (decoded) weeklyDecoded.push(decoded)
    }
    if (weeklyDecoded.length === 0) continue

    // Compute per-pixel AUC (mean NDVI across valid windows)
    var aucData = computePixelAuc_(weeklyDecoded)
    if (!aucData) continue
    stageKCache[season][yr] = aucData

    // Build (SHPI, AUC) pixel pairs using Stage I SHPI rasters
    var shpiData = perYearRastersCache[season] && perYearRastersCache[season][yr]
    if (!shpiData || !shpiData.shpi) continue
    var pairs = buildAucPixelPairs_(aucData, shpiData.shpi, bbox, roi)
    if (pairs.length < 3) continue
    perYearAucPairs[yr] = pairs

    // Per-year OLS R² (SHPI × AUC)
    var xs = pairs.map(function(p) { return p.shpi })
    var ys = pairs.map(function(p) { return p.auc })
    var res = pairs.length >= 3 ? olsArr_(xs, ys) : null
    perYearR2Auc[yr] = res ? res.r2 : null
  }

  // Pool retained pairs and run adaptive binning on AUC (exploratory)
  var pooledAucPairs = []
  years.forEach(function(yr) {
    if (perYearAucPairs[yr]) pooledAucPairs = pooledAucPairs.concat(perYearAucPairs[yr])
  })
  // Re-use stageIAdaptiveBins_ which expects {shpi, cpi} pairs — pass AUC as the 'cpi' field
  var pairsForBins = pooledAucPairs.map(function(p) { return { shpi: p.shpi, cpi: p.auc } })
  var validationAuc = stageIAdaptiveBins_(pairsForBins)

  stageKResult = {
    season:          season,
    perYearAucPairs: perYearAucPairs,
    perYearR2Auc:    perYearR2Auc,
    pooledAucPairs:  pooledAucPairs,
    validationAuc:   validationAuc
  }

  // Show the AUC toggle in ③b
  var toggle = document.getElementById('stageKToggle')
  if (toggle) toggle.style.display = 'flex'
  var aucBtn = document.getElementById('stageKAucBtn')
  if (aucBtn) aucBtn.style.opacity = '1'

  // Log comparison
  var r2Comparison = Object.keys(perYearR2Auc).map(function(yr) {
    var aucR2 = perYearR2Auc[yr]
    var cpiR2 = stageIResult.perYearR2[yr]
    return yr + ': R²_CPI=' + (cpiR2 !== null ? cpiR2.toFixed(3) : 'n/a') +
                '  R²_AUC=' + (aucR2 !== null ? aucR2.toFixed(3) : 'n/a')
  }).join(', ')
  autoLogLine_('[9/8] Stage K: pooled ' + pooledAucPairs.length + ' AUC pairs | AUC R²=' + validationAuc.r_squared +
    ' (' + validationAuc.n_zones + ' bins)')
  if (r2Comparison) autoLogLine_('[9/8] R² comparison: ' + r2Comparison)
}

// ═══════════════════════════════════════════════════════════════════════════
// Stage M — Pass-Date Explorer
// Fetches all 7-day CPI and fallow SHPI pass rasters, decodes them per-pixel,
// and renders:
//   ③a 📅 CPI Passes — per-pixel CPI trajectory through crop season
//   ③a 📅 SHPI Passes — per-pixel SHPI trajectory through fallow window
//   ③e grid — Ref-SHPI × CPI scatter for every 7-day pass (coloured by R²)
//   ③e R²-curve — OLS R² vs calendar date summary line chart
// ═══════════════════════════════════════════════════════════════════════════

// ── M0: helpers ───────────────────────────────────────────────

// Decode a CPI pass PNG (G=CPI×254, A=count) to Float32Array of per-pixel CPI.
// Returns Promise<{pixels: Float32Array, W, H}|null>
function decodeCropPassPng_(b64) {
  return new Promise(function(resolve) {
    if (!b64) { resolve(null); return }
    var img = new Image()
    img.onerror = function() { resolve(null) }
    img.onload = function() {
      var W = img.naturalWidth, H = img.naturalHeight
      var c = document.createElement('canvas'); c.width = W; c.height = H
      var ctx = c.getContext('2d'); ctx.drawImage(img, 0, 0)
      var px = ctx.getImageData(0, 0, W, H).data
      var total = W * H
      var pixels = new Float32Array(total)
      for (var i = 0; i < total; i++) {
        pixels[i] = px[i * 4 + 3] > 0 ? px[i * 4 + 1] / 254 : -1  // G=CPI×254, A=count
      }
      resolve({ pixels: pixels, W: W, H: H })
    }
    img.src = 'data:image/png;base64,' + b64
  })
}

// Decode a fallow SHPI pass PNG (R=SHPI×254, A=count) to Float32Array.
// Returns Promise<{pixels: Float32Array, W, H}|null>
function decodeFallowPassPng_(b64) {
  return new Promise(function(resolve) {
    if (!b64) { resolve(null); return }
    var img = new Image()
    img.onerror = function() { resolve(null) }
    img.onload = function() {
      var W = img.naturalWidth, H = img.naturalHeight
      var c = document.createElement('canvas'); c.width = W; c.height = H
      var ctx = c.getContext('2d'); ctx.drawImage(img, 0, 0)
      var px = ctx.getImageData(0, 0, W, H).data
      var total = W * H
      var pixels = new Float32Array(total)
      for (var i = 0; i < total; i++) {
        pixels[i] = px[i * 4 + 3] > 0 ? px[i * 4] / 254 : -1  // R=SHPI×254, A=count
      }
      resolve({ pixels: pixels, W: W, H: H })
    }
    img.src = 'data:image/png;base64,' + b64
  })
}

// Find the fallow pass with the minimum field-wide pixel sum of valid SHPI values.
// fallowArr: [{date, label, pixels}] — decoded per-pixel SHPI arrays
// Returns index into fallowArr.
function selectRefShpiPassIdx_(fallowArr) {
  var bestIdx = 0, bestSum = Infinity
  for (var i = 0; i < fallowArr.length; i++) {
    var pix = fallowArr[i].pixels
    if (!pix) continue
    var sum = 0, cnt = 0
    for (var j = 0; j < pix.length; j++) {
      if (pix[j] >= 0) { sum += pix[j]; cnt++ }
    }
    if (cnt > 0 && sum < bestSum) { bestSum = sum; bestIdx = i }
  }
  return bestIdx
}

// Compute OLS regression between refSHPI pixels and CPI pixels from a single crop pass.
// refPixels, cpiPixels: Float32Array; -1 = no data.
// Returns { slope, intercept, r2, n } or null if insufficient data.
function computePassOls_(refPixels, cpiPixels) {
  if (!refPixels || !cpiPixels) return null
  var len = Math.min(refPixels.length, cpiPixels.length)
  var xs = [], ys = []
  for (var i = 0; i < len; i++) {
    if (refPixels[i] >= 0 && cpiPixels[i] >= 0) {
      xs.push(refPixels[i]); ys.push(cpiPixels[i])
    }
  }
  if (xs.length < 4) return null
  var res = olsArr_(xs, ys)
  if (!res) return null
  return { slope: res.slope, intercept: res.intercept, r2: res.r2, n: xs.length }
}

// R²-colour: green for high R², grey for weak, darker for near-zero.
function r2ToColor_(r2) {
  if (r2 === null || isNaN(r2)) return '#444'
  if (r2 >= 0.50) return '#2ECC71'
  if (r2 >= 0.30) return '#82E0AA'
  if (r2 >= 0.15) return '#A9DFBF'
  if (r2 >= 0.05) return '#9FE1CB'
  return '#888'
}

// ── M1: Load all crop pass rasters (GAS call) ─────────────────
function loadPassDateExplorer_() {
  if (!roi) { alert('Draw or upload an ROI first.'); return }
  var seasonSel = document.getElementById('stageMSeasonSel')
  var season = seasonSel ? seasonSel.value : (activePipelineSeason || 'kharif')
  stageMSeason = season

  // Use Stage I retained years if available, otherwise fall back to yearStart/yearEnd
  var years = []
  if (stageIResult && stageIResult.tukey && stageIResult.tukey.retained.length > 0) {
    years = stageIResult.tukey.retained.map(Number)
  } else {
    var ys = parseInt(document.getElementById('yearStart').value, 10)
    var ye = parseInt(document.getElementById('yearEnd').value, 10)
    if (isNaN(ys) || isNaN(ye)) { alert('Set a valid year range first.'); return }
    for (var y = ys; y <= ye; y++) years.push(y)
  }

  var btn = document.getElementById('loadStageMBtn')
  var statusEl = document.getElementById('stageMStatus')
  if (btn) { btn.disabled = true; btn.textContent = '⏳ Fetching… (~2–4 min)' }
  if (statusEl) statusEl.textContent = '[1/2] Fetching ' + years.length + '×' + (season === 'kharif' ? '22' : '22') + ' crop pass rasters…'

  google.script.run
    .withSuccessHandler(async function(cropData) {
      if (!cropData.success) {
        if (btn) { btn.disabled = false; btn.textContent = '📡 Load Pass Rasters (~2–4 min)' }
        if (statusEl) statusEl.textContent = '⚠ Crop pass fetch failed: ' + (cropData.error || 'unknown')
        return
      }
      if (statusEl) statusEl.textContent = '[2/2] Fetching fallow SHPI pass rasters…'

      // Store raw and kick off fallow fetch
      cropPassCache[season] = {}
      for (var i = 0; i < cropData.years.length; i++) {
        var yd = cropData.years[i]
        cropPassCache[season][yd.year] = yd.passes
      }

      google.script.run
        .withSuccessHandler(async function(fallowData) {
          if (btn) { btn.disabled = false; btn.textContent = '📡 Load Pass Rasters (~2–4 min)' }
          if (!fallowData.success) {
            if (statusEl) statusEl.textContent = '⚠ Fallow pass fetch failed: ' + (fallowData.error || 'unknown')
            return
          }
          fallowPassCache[season] = {}
          for (var j = 0; j < fallowData.years.length; j++) {
            var fd = fallowData.years[j]
            fallowPassCache[season][fd.year] = fd.passes
          }

          if (statusEl) statusEl.textContent = 'Decoding rasters…'
          await decodeStageMRasters_(season, years)
          populateStageMYearSel_(season, years)
          var gridWrap = document.getElementById('stageMGridWrap')
          if (gridWrap) gridWrap.style.display = 'block'
          var passExplorerStep = document.getElementById('passExplorerStep')
          if (passExplorerStep) passExplorerStep.style.display = 'block'
          setBadge_('passExplorerBadge', '✓')
          // populate year selectors in ③a too
          populateCpiPassYearSel_(season, years)
          populateShpiPassYearSel_(season, years)
          // Reveal ③a new tabs
          var cpiPassTab  = document.getElementById('tsPanelCpiPassesTab')
          var soilPassTab = document.getElementById('tsPanelSoilPassesTab')
          if (cpiPassTab)  cpiPassTab.style.display = 'inline-block'
          if (soilPassTab) soilPassTab.style.display = 'inline-block'

          renderPassDateGrid_()
          updateConcludeFromBestPass_(season)   // N3: update ④ CONCLUDE with per-pass OLS verdict
          if (statusEl) statusEl.textContent = 'Done — ' + years.length + ' years loaded.'
        })
        .withFailureHandler(function(err) {
          if (btn) { btn.disabled = false; btn.textContent = '📡 Load Pass Rasters (~2–4 min)' }
          if (statusEl) statusEl.textContent = '⚠ Fallow pass error: ' + err
        })
        .getAllFallowPassRasters({ geojson: roi, season: season, years: years })
    })
    .withFailureHandler(function(err) {
      if (btn) { btn.disabled = false; btn.textContent = '📡 Load Pass Rasters (~2–4 min)' }
      if (statusEl) statusEl.textContent = '⚠ Crop pass error: ' + err
    })
    .getAllCropPassRasters({ geojson: roi, season: season, years: years })
}

// ── M2: Decode all pass PNGs per season → pixel arrays ────────
async function decodeStageMRasters_(season, years) {
  if (!cropPassPixels[season]) cropPassPixels[season] = {}
  if (!fallowPassPixels[season]) fallowPassPixels[season] = {}
  if (!refShpiPassMap[season]) refShpiPassMap[season] = {}
  if (!stageMOlsMap[season]) stageMOlsMap[season] = {}

  for (var yi = 0; yi < years.length; yi++) {
    var yr = years[yi]
    var cropPasses   = (cropPassCache[season] || {})[yr] || []
    var fallowPasses = (fallowPassCache[season] || {})[yr] || []

    // Decode crop passes
    var decodedCrop = []
    for (var ci = 0; ci < cropPasses.length; ci++) {
      var cp = cropPasses[ci]
      var result = await decodeCropPassPng_(cp.cpiB64)
      decodedCrop.push({ date: cp.date, label: cp.label, pixels: result ? result.pixels : null, W: result ? result.W : 0, H: result ? result.H : 0 })
    }
    cropPassPixels[season][yr] = decodedCrop

    // Decode fallow passes
    var decodedFallow = []
    for (var fi = 0; fi < fallowPasses.length; fi++) {
      var fp = fallowPasses[fi]
      var fresult = await decodeFallowPassPng_(fp.shpiB64)
      decodedFallow.push({ date: fp.date, label: fp.label, pixels: fresult ? fresult.pixels : null })
    }
    fallowPassPixels[season][yr] = decodedFallow

    // Select reference SHPI pass (min field-sum)
    var refIdx = selectRefShpiPassIdx_(decodedFallow)
    refShpiPassMap[season][yr] = {
      idx: refIdx,
      date: decodedFallow[refIdx] ? decodedFallow[refIdx].date : '',
      label: decodedFallow[refIdx] ? decodedFallow[refIdx].label : '',
      pixels: decodedFallow[refIdx] ? decodedFallow[refIdx].pixels : null
    }

    // Compute OLS for each crop pass vs this year's ref SHPI
    var refPixels = refShpiPassMap[season][yr].pixels
    var olsArr2 = []
    for (var ri = 0; ri < decodedCrop.length; ri++) {
      var passOls = computePassOls_(refPixels, decodedCrop[ri].pixels)
      olsArr2.push({ date: decodedCrop[ri].date, label: decodedCrop[ri].label,
        r2: passOls ? passOls.r2 : null,
        slope: passOls ? passOls.slope : null,
        intercept: passOls ? passOls.intercept : null,
        n: passOls ? passOls.n : 0 })
    }
    stageMOlsMap[season][yr] = olsArr2
  }
}

