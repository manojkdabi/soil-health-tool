}

function renderScatterPlotFs_(data) {
  if (!data) return
  var overlay = document.getElementById('chartFs-shpiCpiScatter')
  if (!overlay || !overlay.classList.contains('open')) return
  var canvas = document.getElementById('shpiCpiScatter-fs')
  if (!canvas) return
  if (chartFsInstances['shpiCpiScatter']) { chartFsInstances['shpiCpiScatter'].destroy(); chartFsInstances['shpiCpiScatter'] = null }

  var z = data.zone_stats
  var filterOn = document.getElementById('outlierToggleFs') && document.getElementById('outlierToggleFs').checked

  if (scatterViewMode === 'bins') {
    var pixSample = data.pixel_sample || []
    var zWithData
    if (pixSample.length >= MIN_PIXEL_SAMPLE) {
      zWithData = zoneMeansFromSample_(pixSample, filterOn).filter(function(zs) { return zs.pixel_count > 0 })
    } else {
      var zWithData0 = z.filter(function(zs) { return zs.pixel_count > 0 })
      zWithData = filterOn ? zoneIqrFilter_(zWithData0) : zWithData0
    }
    var removedZones = 0
    var bPts = zWithData.map(function(zs) { return { x: zs.mean_shpi, y: zs.mean_cpi } })
    var reg = olsLine_(bPts)
    var n = bPts.length
    var intSign = reg.intercept >= 0 ? ' + ' : ' - '
    var eqEl = document.getElementById('scatterEq-fs')
    if (eqEl) eqEl.textContent = 'y = ' + reg.slope.toFixed(3) + 'x' + intSign + Math.abs(reg.intercept).toFixed(3) +
      '   R² = ' + reg.r2.toFixed(3) + '  n=' + n + ' zones'

    ;(function() {
      var csEl = document.getElementById('corrSummary-fs')
      if (!csEl) return
      if (n < 2) { csEl.textContent = 'n < 2 zones — regression not computed'; return }
      csEl.textContent = 'OLS: y = ' + reg.slope.toFixed(3) + 'x + ' + reg.intercept.toFixed(3) + '   R² = ' + reg.r2.toFixed(3) + '  (n=' + n + ' zones, exploratory only)'
    })()

    var noteEl = document.getElementById('scatterOutlierNote-fs')
    if (noteEl) noteEl.textContent = pixSample.length >= MIN_PIXEL_SAMPLE
      ? (filterOn ? 'Per-zone IQR outlier removal applied to pixel sample' : 'No outlier filter applied')
      : (filterOn
          ? (removedZones > 0
              ? 'Outliers removed: Tukey 1.5×IQR on zone-mean CPI (' + removedZones + ' zone' + (removedZones > 1 ? 's' : '') + ' removed)'
              : 'Outlier filter: Tukey 1.5×IQR on zone-mean CPI (no outliers detected)')
          : 'No outlier filter applied')

    var zoneBinDataset = {
      type: 'scatter', label: 'Zone means',
      data: zWithData.map(function(zs) { return { x: zs.mean_shpi, y: zs.mean_cpi, zone: zs.zone } }),
      backgroundColor: zWithData.map(function(zs) {
        var c = hexToRgb_(ZONE_COLORS[Math.max(0, Math.min(ZONE_COLORS.length - 1, zs.zone - 1))])
        return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',0.9)'
      }),
      borderColor: '#fff', borderWidth: 1, pointRadius: 6, pointHoverRadius: 8, pointStyle: 'circle', order: 0,
    }
    chartFsInstances['shpiCpiScatter'] = new Chart(canvas.getContext('2d'), {
      data: { datasets: [
        zoneBinDataset,
        { type: 'line', label: 'Fit', data: reg.lineData,
          borderColor: '#F5A623', borderWidth: 2, pointRadius: 0, fill: false, tension: 0 }
      ]},
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: function(ctx) {
            if (ctx.dataset.label === 'Zone means') {
              var zone = ctx.raw.zone || (ctx.dataIndex + 1)
              return 'Z' + zone + '  SHPI=' + ctx.raw.x.toFixed(3) + '  CPI=' + ctx.raw.y.toFixed(3)
            }
            return null
          }}}
        },
        scales: {
          x: { title: { display: true, text: 'SHPI', color: '#9FE1CB', font: { size: 13 } },
               ticks: { color: '#9FE1CB', font: { size: 13 } }, grid: { color: '#1e3d30' } },
          y: { title: { display: true, text: 'CPI',  color: '#9FE1CB', font: { size: 13 } },
               ticks: { color: '#9FE1CB', font: { size: 13 } }, grid: { color: '#1e3d30' } }
        }
      }
    })
    return
  }

  // ── All-pixel mode ────────────────────────────────────────────────────────
  var pixelSample = data.pixel_sample || []
  var totalPx = pixelSample.length
  var pts = filterOn && totalPx > 4 ? binIqrFilter_(pixelSample) : pixelSample.slice()
  var removedCount = totalPx - pts.length

  if (pts.length < 2) {
    var eqEl2 = document.getElementById('scatterEq-fs')
    if (eqEl2) eqEl2.textContent = 'Not enough pixel data'
    var csEl2 = document.getElementById('corrSummary-fs')
    if (csEl2) csEl2.textContent = ''
    return
  }

  var reg2 = olsLine_(pts)
  var n2 = pts.length
  var intSign2 = reg2.intercept >= 0 ? ' + ' : ' - '
  var eqLabel = filterOn && removedCount > 0
    ? 'y = ' + reg2.slope.toFixed(3) + 'x' + intSign2 + Math.abs(reg2.intercept).toFixed(3) +
      '   R² = ' + reg2.r2.toFixed(3) + '  (' + removedCount + ' outliers removed)'
    : 'y = ' + reg2.slope.toFixed(3) + 'x' + intSign2 + Math.abs(reg2.intercept).toFixed(3) +
      '   R² = ' + reg2.r2.toFixed(3) + '  n=' + n2 + ' px'
  var eqEl3 = document.getElementById('scatterEq-fs')
  if (eqEl3) eqEl3.textContent = eqLabel

  var xs2 = pts.map(function(p) { return p.x }), ys2 = pts.map(function(p) { return p.y })
  var pr = pearson_(xs2, ys2)
  var tStat2 = pr * Math.sqrt(n2 - 2) / Math.sqrt(Math.max(1e-15, 1 - pr * pr))
  function normCdfPx_(x) {
    var t2 = 1 / (1 + 0.2316419 * Math.abs(x))
    var d = 0.3989423 * Math.exp(-x * x / 2)
    var p = d * t2 * (0.3193815 + t2 * (-0.3565638 + t2 * (1.7814779 + t2 * (-1.8212560 + t2 * 1.3302744))))
    return x > 0 ? 1 - p : p
  }
  var pVal2 = 2 * normCdfPx_(-Math.abs(tStat2))
  var pStr2 = pVal2 < 0.001 ? 'p < 0.001' : 'p = ' + pVal2.toFixed(3)
  var csEl3 = document.getElementById('corrSummary-fs')
  if (csEl3) csEl3.textContent = 'Pearson r = ' + pr.toFixed(3) + ',  ' + pStr2 + ',  R² = ' + reg2.r2.toFixed(3)

  var noteEl2 = document.getElementById('scatterOutlierNote-fs')
  if (noteEl2) noteEl2.textContent = filterOn
    ? (removedCount > 0
        ? 'Outliers removed: Tukey 1.5×IQR on CPI within each zone (' + removedCount + ' pixels removed)'
        : 'Outlier filter: Tukey 1.5×IQR on CPI within each zone (no outliers detected)')
    : 'No outlier filter applied'

  var zoneGroups = {}
    // Add a small deterministic jitter (±0.4×UINT8 step = ±0.0016) to the x values
  // to visually break the ~30 vertical SHPI stripes caused by UINT8 quantization.
  // Statistics are unaffected — jitter is purely cosmetic.
  var SHPI_JITTER = 0.4 / 254
  pts.forEach(function(p, idx) {
    var zi = p.z != null ? p.z : 0
    if (!zoneGroups[zi]) zoneGroups[zi] = []
    // Deterministic hash using Knuth multiplicative hashing (φ × 2^32 ≈ 2654435761).
    // Produces a stable pseudo-random value in [-1, 1] for each point index.
    var h = ((idx * 2654435761) >>> 0) & 0xFFFF
    var jitter = (h / 65535 - 0.5) * 2 * SHPI_JITTER
    zoneGroups[zi].push({ x: p.x + jitter, y: p.y, z: zi })
  })
  var zoneDatasets = Object.keys(zoneGroups).map(function(zi) {
    zi = parseInt(zi)
    var col = ZONE_COLORS[Math.max(0, Math.min(ZONE_COLORS.length - 1, zi))]
    var c = hexToRgb_(col)
    return {
      type: 'scatter', label: 'Zone ' + (zi + 1),
      data: zoneGroups[zi],
      backgroundColor: 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',0.45)',
      borderColor:     'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',0.0)',
      pointRadius: 2, pointHoverRadius: 5, order: 1,
    }
  })
  chartFsInstances['shpiCpiScatter'] = new Chart(canvas.getContext('2d'), {
    data: { datasets: zoneDatasets.concat([
      { type: 'line', label: 'Fit', data: reg2.lineData,
        borderColor: '#F5A623', borderWidth: 2, pointRadius: 0, fill: false, tension: 0, order: 0 }
    ])},
    options: {
      responsive: true, maintainAspectRatio: false, animation: false,
      plugins: {
        legend: { display: true, position: 'bottom',
          labels: { color: '#9FE1CB', font: { size: 12 }, boxWidth: 10, padding: 6,
            filter: function(item) { return item.text !== 'Fit' } } },
        tooltip: { callbacks: { label: function(ctx) {
          if (ctx.dataset.label === 'Fit') return null
          var zi = ctx.raw.z != null ? ctx.raw.z : parseInt(ctx.dataset.label.replace('Zone ','')) - 1
          return 'Z' + (zi + 1) + '  SHPI=' + ctx.raw.x.toFixed(3) + '  CPI=' + ctx.raw.y.toFixed(3)
        }}}
      },
      scales: {
        x: { title: { display: true, text: 'SHPI', color: '#9FE1CB', font: { size: 13 } },
             ticks: { color: '#9FE1CB', font: { size: 13 } }, grid: { color: '#1e3d30' } },
        y: { title: { display: true, text: 'CPI',  color: '#9FE1CB', font: { size: 13 } },
             ticks: { color: '#9FE1CB', font: { size: 13 } }, grid: { color: '#1e3d30' } }
      }
    }
  })
}

function setCmpScatterMode_(mode) {
  cmpScatterMode = mode
  document.getElementById('cmpTabZones').classList.toggle('active', mode === 'zones')
  document.getElementById('cmpTabSummary').classList.toggle('active', mode === 'summary')
  var rois = loadROIsWithResults_()
  if (rois.length >= 2) renderCmpScatterChart_(rois, loadResultsCache_())
}

function renderCmpScatterChart_(rois, cache) {
  if (cmpScatterMode === 'summary') {
    renderCmpScatterSummary_(rois, cache)
  } else {
    renderCmpScatterZones_(rois, cache)
  }
}

function renderCmpScatterZones_(rois, cache) {
  var datasets = []
  rois.forEach(function(item, idx) {
    var z     = cache[item.id] && cache[item.id].zone_stats
    if (!z) return
    // Only include zones with actual CPI data — empty zones have mean_shpi/cpi=0
    var zNonEmpty = z.filter(function(zs) { return zs.pixel_count > 0 })
    var applyFilter = !document.getElementById('cmpOutlierToggleFs') || document.getElementById('cmpOutlierToggleFs').checked
    var zFiltered = applyFilter ? zoneIqrFilter_(zNonEmpty) : zNonEmpty
    if (!zFiltered.length) return
    var roiColor = ROI_COLORS[idx % ROI_COLORS.length]
    // Colour each zone point by its zone index, use ROI colour as border
    datasets.push({
      type: 'scatter', label: item.name,
      data: zFiltered.map(function(zs) { return { x: zs.mean_shpi, y: zs.mean_cpi } }),
      backgroundColor: zFiltered.map(function(zs) {
        var hex = ZONE_COLORS[Math.min(zs.zone - 1, ZONE_COLORS.length - 1)]
        var c = hexToRgb_(hex)
        return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',0.85)'
      }),
      borderColor: roiColor,
      borderWidth: 2,
      pointRadius: 3, pointHoverRadius: 5
    })
    var xs = zFiltered.map(function(zs) { return zs.mean_shpi })
    var ys = zFiltered.map(function(zs) { return zs.mean_cpi })
    var n = xs.length, sx = 0, sy = 0, sxy = 0, sxx = 0
    xs.forEach(function(x,i){ sx+=x; sy+=ys[i]; sxy+=x*ys[i]; sxx+=x*x })
    var denom = n*sxx-sx*sx
    var slope = Math.abs(denom)>EPSILON_DENOM ? (n*sxy-sx*sy)/denom : 0
    var icpt  = (sy-slope*sx)/n
    var xMin  = xs.reduce(function(m,v){return v<m?v:m}, Infinity)
    var xMax  = xs.reduce(function(m,v){return v>m?v:m}, -Infinity)
    datasets.push({
      type: 'line', label: item.name+' fit',
      data: [{x:xMin,y:slope*xMin+icpt},{x:xMax,y:slope*xMax+icpt}],
      borderColor: roiColor, borderWidth: 1, pointRadius: 0, fill: false,
      tension: 0, borderDash: [3,3]
    })
  })
  _applyCmpScatter(datasets, 'SHPI', 'CPI')
  document.getElementById('cmpScatterLabel').textContent = ''
  var cmpNote = document.getElementById('cmpScatterOutlierNote')
  var cmpNoteFs = document.getElementById('cmpScatterOutlierNote-fs')
  var noteText = 'Outlier filter: Tukey 1.5×IQR on zone-mean CPI per ROI (applied to each ROI independently)'
  if (cmpNote) cmpNote.textContent = noteText
  if (cmpNoteFs) cmpNoteFs.textContent = noteText
}

function renderCmpScatterSummary_(rois, cache) {
  var pts = rois.map(function(item,idx) {
    var z = cache[item.id] && cache[item.id].zone_stats
    if (!z) return null
    // Only average zones with actual data; apply per-ROI zone IQR filter
    var zNE = z.filter(function(zs) { return zs.pixel_count > 0 })
    var applyFilterS = !document.getElementById('cmpOutlierToggleFs') || document.getElementById('cmpOutlierToggleFs').checked
    var zf = applyFilterS ? zoneIqrFilter_(zNE) : zNE
    if (!zf.length) return null
    var meanShpi = zf.reduce(function(a,zs){return a+zs.mean_shpi},0)/zf.length
    var meanCpi  = zf.reduce(function(a,zs){return a+zs.mean_cpi},0)/zf.length
    return { x: meanShpi, y: meanCpi, label: item.name, color: ROI_COLORS[idx%ROI_COLORS.length] }
  }).filter(Boolean)
  if (pts.length < 2) {
    console.warn('renderCmpScatterSummary_: fewer than 2 valid ROIs with zone_stats — skipping summary scatter')
    return
  }
  var xs = pts.map(function(p){return p.x}), ys = pts.map(function(p){return p.y})
  var n = xs.length, sx=0,sy=0,sxy=0,sxx=0
  xs.forEach(function(x,i){sx+=x;sy+=ys[i];sxy+=x*ys[i];sxx+=x*x})
  var denom = n*sxx-sx*sx
  var slope = Math.abs(denom)>EPSILON_DENOM?(n*sxy-sx*sy)/denom:0
  var icpt  = (sy-slope*sx)/n
  var xMin  = xs.reduce(function(m,v){return v<m?v:m}, Infinity)
  var xMax  = xs.reduce(function(m,v){return v>m?v:m}, -Infinity)
  var yMean = sy/n
  var ssTot = ys.reduce(function(a,y){return a+(y-yMean)*(y-yMean)},0)
  var ssRes = xs.reduce(function(a,x,i){return a+(ys[i]-(slope*x+icpt))*(ys[i]-(slope*x+icpt))},0)
  var r2    = ssTot>0?1-ssRes/ssTot:0
  var datasets = [
    {
      type: 'scatter', label: 'ROIs',
      data: pts.map(function(p){return{x:p.x,y:p.y}}),
      backgroundColor: pts.map(function(p){return p.color}),
      pointRadius: 4, pointHoverRadius: 6
    },
    {
      type: 'line', label: 'Global fit',
      data: [{x:xMin,y:slope*xMin+icpt},{x:xMax,y:slope*xMax+icpt}],
      borderColor: '#F5A623', borderWidth: 1.5, pointRadius: 0, fill: false, tension: 0
    }
  ]
  _applyCmpScatter(datasets, 'Mean SHPI', 'Mean CPI', pts)
  var interceptSign = icpt >= 0 ? ' + ' : ' − '
  document.getElementById('cmpScatterLabel').textContent =
    'Global: y = ' + slope.toFixed(3) + 'x' + interceptSign + Math.abs(icpt).toFixed(3) + '   R² = ' + r2.toFixed(3)
  var cmpNoteS = document.getElementById('cmpScatterOutlierNote')
  var cmpNoteSFs = document.getElementById('cmpScatterOutlierNote-fs')
  var noteTxtS = 'Outlier filter: Tukey 1.5×IQR on zone-mean CPI per ROI (applied to each ROI independently)'
  if (cmpNoteS) cmpNoteS.textContent = noteTxtS
  if (cmpNoteSFs) cmpNoteSFs.textContent = noteTxtS
}

function _applyCmpScatter(datasets, xLabel, yLabel, tooltipPts) {
  if (cmpScatterChart) { cmpScatterChart.destroy(); cmpScatterChart = null }
  var ctx = document.getElementById('cmpScatterChart').getContext('2d')
  cmpScatterChart = new Chart(ctx, {
    data: { datasets: datasets },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: function(ctx) {
              if (tooltipPts && ctx.datasetIndex === 0) {
                var p = tooltipPts[ctx.dataIndex]
                return p ? p.label + ' (' + ctx.raw.x.toFixed(3) + ', ' + ctx.raw.y.toFixed(3) + ')' : ''
              }
              // Per-zone mode: show "ROI — Z(n)"
              if (!tooltipPts && ctx.dataset.type === 'scatter') {
                return ctx.dataset.label + ' — Z' + (ctx.dataIndex + 1) +
                  '  (' + ctx.raw.x.toFixed(3) + ', ' + ctx.raw.y.toFixed(3) + ')'
              }
              return null
            }
          }
        }
      },
      scales: {
        x: { title: { display: true, text: xLabel, color: '#9FE1CB', font: { size: 9 } },
             ticks: { color: '#9FE1CB', font: { size: 9 } }, grid: { color: '#1e3d30' } },
        y: { title: { display: true, text: yLabel, color: '#9FE1CB', font: { size: 9 } },
             ticks: { color: '#9FE1CB', font: { size: 9 } }, grid: { color: '#1e3d30' } }
      }
    }
  })
}

