// ── E1: Tukey 1.5-IQR fence helper ──────────────────────────────────────────
// perYearMeans: [{year:string, mean:number}]
// Returns {retained:string[], rejected:[{year,value,lo,hi,side}]}
// n<4: retain all. IQR==0: fallback to mean+/-1.5*std.
function tukeyFence_(perYearMeans) {
  var n = perYearMeans.length
  if (n < 4) return { retained: perYearMeans.map(function(d) { return d.year }), rejected: [] }
  var sorted = perYearMeans.slice().sort(function(a, b) { return a.mean - b.mean })
  var vals = sorted.map(function(d) { return d.mean })
  function nearestRankPct(v, p) {
    var idx = Math.ceil(p / 100 * v.length) - 1
    return v[Math.max(0, Math.min(idx, v.length - 1))]
  }
  var Q1 = nearestRankPct(vals, 25)
  var Q3 = nearestRankPct(vals, 75)
  var IQR = Q3 - Q1
  var lo, hi
  if (IQR === 0) {
    var mean = vals.reduce(function(s, v) { return s + v }, 0) / n
    var std = Math.sqrt(vals.reduce(function(s, v) { return s + (v - mean) * (v - mean) }, 0) / (n - 1))
    lo = mean - 1.5 * std
    hi = mean + 1.5 * std
  } else {
    lo = Q1 - 1.5 * IQR
    hi = Q3 + 1.5 * IQR
  }
  var retained = [], rejected = []
  perYearMeans.forEach(function(d) {
    if (d.mean >= lo && d.mean <= hi) {
      retained.push(d.year)
    } else {
      rejected.push({ year: d.year, value: d.mean, lo: lo, hi: hi,
                      side: d.mean < lo ? 'below' : 'above' })
    }
  })
  return { retained: retained, rejected: rejected }
}

// ── E1: CPI year filter (per-year seasonal mean → Tukey fence) ───────────────
// season: 'kharif' (months 6-10) | 'rabi' (months 11/12 of Y + 1-3 of Y+1 → year Y)
// Updates tsSelectedYears and checkboxes. Returns tukeyFence_ result.
function congruentCpiYears_(season) {
  if (!tsData || tsData.length === 0) return { retained: [], rejected: [] }
  // Use custom crop window if set by runWithWindows_(); otherwise fall back to hard-coded season defaults
  var useCustom = (customCropMonthStart !== null && customCropMonthEnd !== null)
  var byYear = {}
  tsData.forEach(function(d) {
    var yr = d.date.substring(0, 4)
    var mo = parseInt(d.date.substring(5, 7), 10)
    var inWindow
    if (useCustom) {
      // Custom window is always within one calendar year (no year rollback needed)
      inWindow = (mo >= customCropMonthStart && mo <= customCropMonthEnd)
    } else if (season === 'kharif') {
      inWindow = (mo >= 6 && mo <= 10)
    } else {
      inWindow = (mo >= 11 || mo <= 3)
      if (inWindow && mo <= 3) yr = String(parseInt(yr, 10) - 1)
    }
    if (!inWindow) return
    if (!byYear[yr]) byYear[yr] = []
    byYear[yr].push(computeCpiFromRow_(d))
  })
  var perYearMeans = Object.keys(byYear).map(function(yr) {
    var v = byYear[yr]
    return { year: yr, mean: v.reduce(function(s, x) { return s + x }, 0) / v.length }
  })
  var result = tukeyFence_(perYearMeans)
  if (tsSelectedYears) {
    tsSelectedYears = new Set(result.retained)
    document.querySelectorAll('#tsYearChecks input[type=checkbox]').forEach(function(cb) {
      cb.checked = tsSelectedYears.has(cb.value)
    })
    if (tsData && tsViewMode === 'season') renderTsChart_(tsCurIndex)
  }
  return result
}

// ── E2: SHPI year filter (per-year fallow-window mean → Tukey fence) ─────────
// season: 'kharif' (pre-Kharif fallow: months 2-5) | 'rabi' (pre-Rabi fallow: months 10-11)
// Updates soilSelectedYears and checkboxes. Returns tukeyFence_ result.
function congruentShpiYears_(season) {
  if (!soilTsData || soilTsData.length === 0) return { retained: [], rejected: [] }
  // Use custom bare-soil window if set by runWithWindows_(); otherwise fall back to hard-coded season defaults
  var useCustom = (customBareMonthStart !== null && customBareMonthEnd !== null)
  var byYear = {}
  soilTsData.forEach(function(d) {
    var yr = d.date.substring(0, 4)
    var mo = parseInt(d.date.substring(5, 7), 10)
    var inWindow
    if (useCustom) {
      inWindow = (mo >= customBareMonthStart && mo <= customBareMonthEnd)
    } else if (season === 'kharif') {
      inWindow = (mo >= 2 && mo <= 5)
    } else {
      inWindow = (mo >= 10 && mo <= 11)
    }
    if (!inWindow) return
    if (!byYear[yr]) byYear[yr] = []
    byYear[yr].push(computeShpiFromRow_(d))
  })
  var perYearMeans = Object.keys(byYear).map(function(yr) {
    var v = byYear[yr]
    return { year: yr, mean: v.reduce(function(s, x) { return s + x }, 0) / v.length }
  })
  var result = tukeyFence_(perYearMeans)
  if (soilSelectedYears) {
    soilSelectedYears = new Set(result.retained)
    document.querySelectorAll('#soilYearChecks input[type=checkbox]').forEach(function(cb) {
      cb.checked = soilSelectedYears.has(cb.value)
    })
    if (soilTsData && soilTsViewMode === 'season') renderSoilTsChart_(soilCurIndex)
  }
  return result
}

