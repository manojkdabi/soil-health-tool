// Draw a tiny scatter on a 60×50 canvas (ref-SHPI x, CPI y)
function drawMiniScatter_(canvas, refPix, cpiPix, r2) {
  var ctx = canvas.getContext('2d')
  var W = canvas.width, H = canvas.height
  ctx.fillStyle = '#1a3d30'; ctx.fillRect(0, 0, W, H)
  if (!refPix || !cpiPix) {
    ctx.fillStyle = '#3a6a4a'; ctx.font = '8px sans-serif'; ctx.textAlign = 'center'
    ctx.fillText('no data', W / 2, H / 2); return
  }
  var len = Math.min(refPix.length, cpiPix.length)
  var pts = []
  for (var i = 0; i < len; i++) {
    if (refPix[i] >= 0 && cpiPix[i] >= 0) pts.push({ x: refPix[i], y: cpiPix[i] })
  }
  if (pts.length === 0) {
    ctx.fillStyle = '#3a6a4a'; ctx.font = '8px sans-serif'; ctx.textAlign = 'center'
    ctx.fillText('no pts', W / 2, H / 2); return
  }
  var pad = 4
  var dotColor = r2ToColor_(r2)
  ctx.fillStyle = dotColor
  pts.forEach(function(p) {
    var px = pad + p.x * (W - 2 * pad)
    var py = (H - pad) - p.y * (H - 2 * pad)
    ctx.beginPath(); ctx.arc(px, py, 1.2, 0, 2 * Math.PI); ctx.fill()
  })
}

