function openCompareMap_() {
  var rois  = loadROIsWithResults_()
  var cache = loadResultsCache_()
  if (rois.length < 2) { alert('Need at least 2 ROIs with results.'); return }

  var container = document.getElementById('compare-fs-container')
  container.style.display = 'block'

  var mapEl = document.getElementById('compare-fs-map')
  if (compareMapFs) { compareMapFs.remove(); compareMapFs = null }
  compareMapFs = L.map(mapEl, { zoomControl: true, attributionControl: false })
  var mainBaseLayers2 = [esriSatellite, esriTopo, esriStreet, osmStandard]
  var activeBase2 = mainBaseLayers2.find(function(l) { return map.hasLayer(l) }) || esriSatellite
  L.tileLayer(activeBase2._url, Object.assign({}, activeBase2.options)).addTo(compareMapFs)
  if (monthlyLayer && map.hasLayer(monthlyLayer)) {
    L.tileLayer(monthlyLayer._url, Object.assign({}, monthlyLayer.options)).addTo(compareMapFs)
  }

  var allBounds = []
  rois.forEach(function(item, idx) {
    var color = ROI_COLORS[idx % ROI_COLORS.length]
    var lyr   = L.geoJSON(item.geojson, {
      style: { color: color, weight: 2, fillColor: color, fillOpacity: 0.2 }
    }).addTo(compareMapFs)
    allBounds.push(lyr.getBounds())

    var d = cache[item.id]
    if (d && d.raster_png_b64) {
      var bb = geomBbox_(item.geojson)
      L.imageOverlay('data:image/png;base64,' + d.raster_png_b64,
        [[bb[1],bb[0]],[bb[3],bb[2]]], { opacity: 0.65 }).addTo(compareMapFs)
    }
  })

  if (allBounds.length) {
    var combined = allBounds[0]
    for (var i = 1; i < allBounds.length; i++) combined.extend(allBounds[i])
    compareMapFs.fitBounds(combined, { padding: [20, 20] })
  }

  // Legend
  var legendEl = document.getElementById('compareMapLegend')
  legendEl.innerHTML = '<div style="font-size:10px;font-weight:700;color:#F5A623;text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px">ROI Legend</div>' +
    rois.map(function(item, idx) {
      return '<div style="display:flex;align-items:center;gap:6px;margin-bottom:5px">' +
        '<span style="display:inline-block;width:14px;height:10px;border-radius:2px;background:' + ROI_COLORS[idx%ROI_COLORS.length] + '"></span>' +
        '<span style="font-size:11px;color:#9FE1CB">' + escHtml_(item.name) + '</span>' +
      '</div>'
    }).join('')
}

function closeCompareMap_() {
  document.getElementById('compare-fs-container').style.display = 'none'
  if (compareMapFs) { compareMapFs.remove(); compareMapFs = null }
}

