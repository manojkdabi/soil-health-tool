<!-- ── Stage K: NDVI-AUC per pixel ──────────────────────────────────────── -->
<script>

// ── K-helper: Decode a single biweekly NDVI PNG ───────────────────────────────
// PNG encoding: R = best NDVI×254 in the window; A = 1 valid, 0 = all cloudy.
// Returns Promise<{arr: Float32Array, W, H}|null>; arr[i] = NDVI in [0,1] or -1 for no-data.
function decodeWeeklyNdvi_(b64) {
  return new Promise(function(resolve) {
    if (!b64) { resolve(null); return }
    var img = new Image()
    img.onload = function() {
      var W = img.naturalWidth, H = img.naturalHeight
      var c = document.createElement('canvas'); c.width = W; c.height = H
      var ctx = c.getContext('2d'); ctx.drawImage(img, 0, 0)
      var px = ctx.getImageData(0, 0, W, H).data
      var n = W * H
      var arr = new Float32Array(n)
      for (var i = 0; i < n; i++) {
        arr[i] = px[i * 4 + 3] > 0 ? px[i * 4] / 254 : -1  // R = NDVI×254, A = valid
      }
      resolve({ arr: arr, W: W, H: H })
    }
    img.onerror = function() { resolve(null) }
    img.src = 'data:image/png;base64,' + b64
  })
}

// ── K-helper: Compute per-pixel mean NDVI (= normalized AUC) ─────────────────
// weeklyDecoded: [{arr: Float32Array, W, H}, ...] — one per biweekly window.
// Returns Float32Array length W×H; value = mean of valid NDVI observations, -1 if none.
function computePixelAuc_(weeklyDecoded) {
  if (!weeklyDecoded || weeklyDecoded.length === 0) return null
  var first = weeklyDecoded.find(function(d) { return d !== null })
  if (!first) return null
  var W = first.W, H = first.H, n = W * H
  var sumArr = new Float32Array(n)
  var cntArr = new Uint8Array(n)
  weeklyDecoded.forEach(function(wk) {
    if (!wk || !wk.arr) return
    for (var i = 0; i < n; i++) {
      if (wk.arr[i] >= 0) { sumArr[i] += wk.arr[i]; cntArr[i]++ }
    }
  })
  var aucArr = new Float32Array(n)
  for (var i = 0; i < n; i++) {
    aucArr[i] = cntArr[i] > 0 ? sumArr[i] / cntArr[i] : -1
  }
  return { arr: aucArr, W: W, H: H }
}

// ── K-helper: Build (SHPI, AUC) pixel pairs for one year ─────────────────────
function buildAucPixelPairs_(aucData, shpiArr, bbox, geojson) {
  var pairs = []
  if (!aucData || !aucData.arr || !shpiArr) return pairs
  var W = aucData.W, H = aucData.H, n = W * H
  if (shpiArr.length !== n) return pairs
  var polyMask = null
  if (bbox && geojson) {
    var lngRange = bbox[2] - bbox[0], latRange = bbox[3] - bbox[1]
    if (lngRange > 0 && latRange > 0) {
      polyMask = new Uint8Array(n)
      for (var mi = 0; mi < n; mi++) {
        var col = mi % W, row = Math.floor(mi / W)
        var lng = bbox[0] + (col + 0.5) / W * lngRange
        var lat = bbox[3] - (row + 0.5) / H * latRange
        polyMask[mi] = pointInPolygon_(lng, lat, geojson) ? 1 : 0
      }
    }
  }
  for (var i = 0; i < n; i++) {
    if (polyMask && !polyMask[i]) continue
    if (aucData.arr[i] < 0 || shpiArr[i] < 0) continue
    pairs.push({ shpi: shpiArr[i], auc: aucData.arr[i] })
  }
  return pairs
}

// ── K: Toggle CPI / AUC mode in ③b scatter ────────────────────────────────────
function setStageKMode_(mode) {
