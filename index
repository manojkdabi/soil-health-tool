// ── Stage G: Cadence toggle + period stepper ────────────────────────────────
var shCurrentPeriod = 1   // period index (1-based) for weekly/biweekly stepper

// Returns {start:'YYYY-MM-DD', end:'YYYY-MM-DD', label:'W06 — Feb 6–12'} for current period
function currentPeriodDates_() {
  var cadence = document.getElementById('shCadence').value
  var year    = parseInt(document.getElementById('shPeriodYear').value, 10)
  if (isNaN(year)) return null
  var cadenceDays = cadence === 'weekly' ? 7 : 14
  var maxPeriods  = cadence === 'weekly' ? 52 : 26
  var p = Math.max(1, Math.min(shCurrentPeriod, maxPeriods))
  var jan1 = new Date(Date.UTC(year, 0, 1))
  var startMs = jan1.getTime() + (p - 1) * cadenceDays * 86400000
  var endMs   = startMs + (cadenceDays - 1) * 86400000
  // Cap end at Dec 31 of the year
  var dec31 = new Date(Date.UTC(year, 11, 31)).getTime()
  if (endMs > dec31) endMs = dec31
  function fmtDate(ms) {
    var d = new Date(ms)
    var mo = String(d.getUTCMonth() + 1).padStart(2, '0')
    var dy = String(d.getUTCDate()).padStart(2, '0')
    return d.getUTCFullYear() + '-' + mo + '-' + dy
  }
  function fmtShort(ms) {
    var d = new Date(ms)
    return MON_ABBR[d.getUTCMonth()] + ' ' + d.getUTCDate()
  }
  var prefix = cadence === 'weekly' ? ('W' + String(p).padStart(2, '0')) : ('BW' + String(p).padStart(2, '0'))
  return {
    start: fmtDate(startMs),
    end:   fmtDate(endMs),
    label: prefix + ' — ' + fmtShort(startMs) + '–' + fmtShort(endMs)
  }
}

function updateShPeriodLabel_() {
