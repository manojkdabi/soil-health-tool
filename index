}

// Update ③c scatter — pool ALL accepted years, per-year faint OLS + pooled bold OLS + 95% CI band
// Gaps 1, 2, 3 fix
function updatePooledScatterForPass_(season, clickedYear, passIdx, passLabel) {
  // Determine which years to pool (all Stage I retained years, or just clicked year if no Stage I)
  var acceptedYears = (stageIResult && stageIResult.tukey && stageIResult.tukey.retained.length > 0)
    ? stageIResult.tukey.retained.map(Number).sort()
    : [clickedYear]
  var rejectedYears = (stageIResult && stageIResult.tukey)
    ? stageIResult.tukey.rejected.map(function(r) { return Number(r.year) })
    : []

  // Find the clicked pass date label so we can match it across other years
  var clickedPasses = (cropPassPixels[season] || {})[clickedYear] || []
  var clickedPassDate = clickedPasses[passIdx] ? clickedPasses[passIdx].date : null
  var clickedLabel   = clickedPasses[passIdx] ? (clickedPasses[passIdx].label || passLabel) : passLabel

  var YEAR_COLORS_M = ['#9FE1CB','#F67019','#F53794','#4DC9F6','#ACC236','#F5A623','#00A950','#58595B']
  // Helper: hex color → rgba string with alpha
  function hexToRgba_(hex, alpha) {
    var r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16)
    return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')'
  }

  // Per-year pixel pairs and OLS
  var perYearDatasets = []
  var perYearOlsLines = []
  var allPts = []

  acceptedYears.forEach(function(yr, yi) {
    var refData    = (refShpiPassMap[season] || {})[yr]
    var cropPasses = (cropPassPixels[season] || {})[yr] || []
    if (!refData) return

    // Find the best-matching pass index for this year by date proximity
    var matchIdx = passIdx // default to same index
    if (clickedPassDate && yr !== clickedYear) {
      var best = Infinity, bi = passIdx
      cropPasses.forEach(function(p, pi) {
        if (!p.date) return
        var diff = Math.abs(new Date(p.date).getTime() - new Date(clickedPassDate).getTime())
        if (diff < best) { best = diff; bi = pi }
      })
      matchIdx = bi
    }

    var cpiPass = cropPasses[matchIdx]
    if (!cpiPass || !cpiPass.pixels) return

    var refPix = refData.pixels
    var cpiPix = cpiPass.pixels
    var len = Math.min(refPix.length, cpiPix.length)
    var pts = []
    for (var i = 0; i < len; i++) {
      if (refPix[i] >= 0 && cpiPix[i] >= 0) pts.push({ x: refPix[i], y: cpiPix[i] })
    }
    if (pts.length === 0) return

    var color = YEAR_COLORS_M[yi % YEAR_COLORS_M.length]
    perYearDatasets.push({
      label: String(yr),
      data: pts.map(function(p) { return { x: p.x, y: p.y } }),
      backgroundColor: hexToRgba_(color, 0.45),
      pointRadius: 2.5, pointHoverRadius: 4, type: 'scatter'
    })

    // Per-year faint OLS line
    var yrOls = computeOlsFull_(pts.map(function(p) { return p.x }), pts.map(function(p) { return p.y }))
    if (yrOls) {
      var xMin = pts.reduce(function(m, p) { return p.x < m ? p.x : m }, Infinity)
      var xMax = pts.reduce(function(m, p) { return p.x > m ? p.x : m }, -Infinity)
      perYearOlsLines.push({
        label: 'OLS_' + yr,
        data: [{ x: xMin, y: yrOls.slope * xMin + yrOls.intercept },
               { x: xMax, y: yrOls.slope * xMax + yrOls.intercept }],
        type: 'line', borderColor: color, backgroundColor: 'transparent',
        pointRadius: 0, borderWidth: 0.9, borderDash: [3, 3], order: 2
      })
    }

    pts.forEach(function(p) { allPts.push(p) })
  })

  // Rejected year points (grey, small)
  rejectedYears.forEach(function(yr) {
    var refData    = (refShpiPassMap[season] || {})[yr]
    var cropPasses = (cropPassPixels[season] || {})[yr] || []
    if (!refData) return
    var matchIdx = passIdx
    if (clickedPassDate) {
      var best = Infinity, bi = passIdx
      cropPasses.forEach(function(p, pi) {
        if (!p.date) return
        var diff = Math.abs(new Date(p.date).getTime() - new Date(clickedPassDate).getTime())
        if (diff < best) { best = diff; bi = pi }
      })
      matchIdx = bi
    }
    var cpiPass = cropPasses[matchIdx]
    if (!cpiPass || !cpiPass.pixels) return
    var refPix = refData.pixels, cpiPix = cpiPass.pixels
    var len = Math.min(refPix.length, cpiPix.length)
    var rejPts = []
    for (var i = 0; i < len; i++) {
      if (refPix[i] >= 0 && cpiPix[i] >= 0) rejPts.push({ x: refPix[i], y: cpiPix[i] })
    }
    if (rejPts.length > 0) {
      perYearDatasets.unshift({
        label: String(yr) + ' (rej)',
        data: rejPts.map(function(p) { return { x: p.x, y: p.y } }),
        backgroundColor: 'rgba(160,160,160,0.3)', pointRadius: 2, type: 'scatter'
      })
    }
  })

  if (allPts.length === 0) return

  // Pooled OLS with 95% CI band
  var pooledOls = computeOlsFull_(allPts.map(function(p) { return p.x }), allPts.map(function(p) { return p.y }))

  var pooledOlsData = [], ciUpperData = [], ciLowerData = []
  if (pooledOls) {
    var xs = allPts.map(function(p) { return p.x }).sort(function(a, b) { return a - b })
    var xMin = xs[0], xMax = xs[xs.length - 1]
    var nSteps = 40
    for (var si = 0; si <= nSteps; si++) {
      var xi = xMin + (xMax - xMin) * si / nSteps
      var yi = pooledOls.slope * xi + pooledOls.intercept
      pooledOlsData.push({ x: xi, y: yi })
      // 95% CI: y_hat ± t(0.025, n-2) * se * sqrt(1/n + (x-xm)^2 / ssx)
      var ci = pooledOls.se * 1.96 * Math.sqrt(1 / pooledOls.n + Math.pow(xi - pooledOls.xm, 2) / pooledOls.ssx)
      ciUpperData.push({ x: xi, y: yi + ci })
      ciLowerData.push({ x: xi, y: yi - ci })
    }
  }

  var datasets = perYearDatasets.concat(perYearOlsLines)
  if (ciUpperData.length > 0) {
    var ciStyle = { type: 'line', borderColor: 'rgba(245,166,35,0.25)', backgroundColor: 'rgba(245,166,35,0.07)', pointRadius: 0, borderWidth: 1, order: 1, isCI: true }
    datasets.push(Object.assign({ label: 'CI+', data: ciUpperData, fill: '+1' }, ciStyle))
    datasets.push(Object.assign({ label: 'CI-', data: ciLowerData, fill: false }, ciStyle))
  }
  if (pooledOlsData.length > 0) {
    datasets.push({ label: 'Pooled OLS', data: pooledOlsData, type: 'line', borderColor: '#F5A623', backgroundColor: 'transparent', pointRadius: 0, borderWidth: 2.5, order: 0, isPooledOls: true })
  }

  var corrEl = document.getElementById('corrSummary')
  var eqEl   = document.getElementById('scatterEq')
  if (corrEl) corrEl.textContent = 'Pass ' + clickedLabel + '  n=' + allPts.length + ' (' + acceptedYears.length + ' yr)'
  if (eqEl && pooledOls) eqEl.textContent = 'y = ' + pooledOls.slope.toFixed(3) + 'x + ' + pooledOls.intercept.toFixed(3) + '  R²=' + pooledOls.r2.toFixed(3)

  renderPooledPassScatter_(datasets, pooledOls ? pooledOls.r2 : null, clickedLabel)
}

// OLS helper with standard error for CI band: returns {slope, intercept, r2, se, n, xm, ssx}
function computeOlsFull_(xs, ys) {
  var n = xs.length
  if (n < 2) return null          // need at least 2 points for OLS
  var xm = xs.reduce(function(a, b) { return a + b }, 0) / n
  var ym = ys.reduce(function(a, b) { return a + b }, 0) / n
  var ssx = 0, sxy = 0
  for (var i = 0; i < n; i++) { var dx = xs[i] - xm; ssx += dx * dx; sxy += dx * (ys[i] - ym) }
  if (ssx === 0) return null
  var slope = sxy / ssx
  var intercept = ym - slope * xm
  var ssRes = 0, ssTot = 0
  for (var j = 0; j < n; j++) {
    var r = ys[j] - (slope * xs[j] + intercept); ssRes += r * r
    var t = ys[j] - ym; ssTot += t * t
  }
  var r2  = ssTot > 0 ? 1 - ssRes / ssTot : 0
  // SE requires n >= 3 (df = n-2 > 0); return 0 for n=2 so CI band collapses gracefully
  var mse = n >= 3 ? ssRes / (n - 2) : 0
  var se  = Math.sqrt(mse)
  return { slope: slope, intercept: intercept, r2: r2, se: se, n: n, xm: xm, ssx: ssx, ym: ym }
}

// Legacy thin wrapper — kept for callers outside Stage M
function computeOls_(xs, ys) {
  var res = computeOlsFull_(xs, ys)
  if (!res) return null
  return { slope: res.slope, intercept: res.intercept, r2: res.r2, xm: res.xm, ym: res.ym }
}

