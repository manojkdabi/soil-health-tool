// Shows per-year mean CPI (green bars) and mean SHPI (brown bars) side-by-side,
// with a CPI÷SHPI ratio line (secondary y-axis, gold).
// Relies on computeYearSeasonPairs_() which uses tsData + soilTsData.
let ratioChartSeason_ = 'kharif'  // last-rendered season for ratio tab
function renderRatioChart_(season) {
  if (!season) season = ratioChartSeason_
  ratioChartSeason_ = season

  // Update season button active state
  var kBtn = document.getElementById('ratioSeasonKharif')
  var rBtn = document.getElementById('ratioSeasonRabi')
  if (kBtn) kBtn.classList.toggle('active', season === 'kharif')
  if (rBtn) rBtn.classList.toggle('active', season === 'rabi')

  var statusEl = document.getElementById('ratioChartStatus')
  var canvasEl = document.getElementById('ratioChart')

  if (!tsData || !soilTsData) {
    if (statusEl) statusEl.textContent = 'ⓘ Fetch both Crop and Soil series first.'
    if (canvasEl) canvasEl.style.display = 'none'
    return
  }

  var pairs = computeYearSeasonPairs_(season)
  if (!pairs.length) {
    if (statusEl) statusEl.textContent = 'ⓘ No overlapping years between CPI and SHPI data.'
    if (canvasEl) canvasEl.style.display = 'none'
    return
  }

  if (canvasEl) canvasEl.style.display = 'block'
  if (statusEl) statusEl.textContent = ''

  // Destroy previous instance
  if (ratioChart) { ratioChart.destroy(); ratioChart = null }

  var labels = pairs.map(function(p) { return p.year })
  var cpiVals  = pairs.map(function(p) { return Math.round(p.cpi  * 1000) / 1000 })
  var shpiVals = pairs.map(function(p) { return Math.round(p.shpi * 1000) / 1000 })
  var ratioVals = pairs.map(function(p) {
    return p.shpi > 0 ? Math.round((p.cpi / p.shpi) * 1000) / 1000 : null
  })

  var ctx = document.getElementById('ratioChart').getContext('2d')
  ratioChart = new Chart(ctx, {
    data: {
      labels: labels,
      datasets: [
        {
          type: 'bar',
          label: 'CPI (crop)',
          data: cpiVals,
          backgroundColor: 'rgba(80,200,140,0.65)',
          borderColor: '#4ecdc4',
          borderWidth: 1,
          yAxisID: 'yLeft'
        },
        {
          type: 'bar',
          label: 'SHPI (soil)',
          data: shpiVals,
          backgroundColor: 'rgba(180,120,60,0.65)',
          borderColor: '#cd853f',
          borderWidth: 1,
          yAxisID: 'yLeft'
        },
        {
          type: 'line',
          label: 'CPI÷SHPI ratio',
          data: ratioVals,
          borderColor: '#F5A623',
          backgroundColor: 'transparent',
          borderWidth: 2,
          pointRadius: 4,
          pointHoverRadius: 7,
          fill: false,
          tension: 0.3,
          spanGaps: true,
          yAxisID: 'yRight'
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: true,
          position: 'bottom',
          labels: { color: '#9FE1CB', font: { size: 8 }, boxWidth: 8, padding: 4 }
        },
        tooltip: {
          callbacks: {
            label: function(item) {
              if (item.datasetIndex === 2) return 'CPI÷SHPI: ' + item.raw
              return item.dataset.label + ': ' + item.raw
            }
          }
        }
      },
      scales: {
        x: {
          ticks: { color: '#9FE1CB', font: { size: 8 } },
          grid: { color: 'rgba(255,255,255,0.07)' }
        },
        yLeft: {
          type: 'linear',
          position: 'left',
          min: 0, max: 1,
          title: { display: true, text: 'Index [0–1]', color: '#9FE1CB', font: { size: 7 } },
          ticks: { color: '#9FE1CB', font: { size: 7 } },
          grid: { color: 'rgba(255,255,255,0.07)' }
        },
        yRight: {
          type: 'linear',
          position: 'right',
          title: { display: true, text: 'Ratio', color: '#F5A623', font: { size: 7 } },
          ticks: { color: '#F5A623', font: { size: 7 } },
          grid: { drawOnChartArea: false }
        }
      }
    }
  })
  if (statusEl) {
    var seasonLabel = season === 'kharif' ? 'Kharif' : 'Rabi'
    statusEl.textContent = seasonLabel + ' — ' + pairs.length + ' year' + (pairs.length > 1 ? 's' : '') +
      ' | bars = index values  |  gold line = CPI÷SHPI ratio'
  }
}

