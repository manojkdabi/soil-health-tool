}

function stepPeriod_(delta) {
  var cadence    = document.getElementById('shCadence').value
  var maxPeriods = cadence === 'weekly' ? 52 : 26
  shCurrentPeriod = shCurrentPeriod + delta
  if (shCurrentPeriod < 1) shCurrentPeriod = maxPeriods
  if (shCurrentPeriod > maxPeriods) shCurrentPeriod = 1
  updateShPeriodLabel_()
}

